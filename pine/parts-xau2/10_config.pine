// =============================================================================
//  L0 - CONFIG  (moi tinh nang v2 co toggle rieng - test duoc doc lap)
// =============================================================================

// General
x2_confirmOnly = input.bool(true,  "Chi tin hieu nen da dong (no-repaint)", group = "XAU2 · Chung", display = display.data_window)
x2_payloadMode = input.string("Full", "Webhook payload", options = ["Full", "Slim", "Off"], group = "XAU2 · Chung", display = display.data_window)

// Market Structure (BOS / CHoCH / MSS / Retest / Fail / Cont / Pull)
x2_ms_swLen      = input.int(5,    "Swing lookback (nen)", minval = 2, maxval = 20, group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_bosOn      = input.bool(true, "Hien thi BOS",                 group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_chochOn    = input.bool(true, "Hien thi CHoCH",               group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_mssOn      = input.bool(true, "Hien thi MSS (break + displ.)", group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_retestOn   = input.bool(true, "Phat hien Retest sau BOS",     group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_retestBars = input.int(10,    "Cua so retest (nen)", minval = 1, maxval = 100, group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_retestTol  = input.float(0.5, "Retest tolerance (x ATR)", minval = 0.0, step = 0.1, group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_failOn     = input.bool(true, "Phat hien Failed Breakout",    group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_failBars   = input.int(5,     "Cua so failed breakout (nen)", minval = 1, maxval = 50, group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_contOn     = input.bool(true, "Trend continuation (HH/LL)",   group = "XAU2 · Market Structure", display = display.data_window)
x2_ms_pullOn     = input.bool(true, "Pullback ve EMA",              group = "XAU2 · Market Structure", display = display.data_window)

// Liquidity & Market Location (PD/PW, Session HL, Eq, Sweep, Trendline)
x2_liq_eqTol   = input.float(0.05, "Equal Hi/Lo tolerance (x ATR)", minval = 0.0, step = 0.01, group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_sweepOn = input.bool(true,  "Hien thi Liquidity Sweep",      group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_pdOn    = input.bool(true,  "Hien thi PDH / PDL",            group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_pwOn    = input.bool(true,  "Hien thi PWH / PWL",            group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_sessOn  = input.bool(true,  "Hien thi Session High / Low",   group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_tlOn    = input.bool(true,  "Trendline 2 diem",              group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_tlTol   = input.float(0.25, "Trendline touch tolerance (x ATR)", minval = 0.05, step = 0.05, group = "XAU2 · Liquidity", display = display.data_window)
x2_liq_tlMaxDev = input.float(10.0, "Trendline toi da xa gia (x ATR)", minval = 1.0, step = 1.0, group = "XAU2 · Liquidity", display = display.data_window)

// S/R Zones
x2_sr_left     = input.int(10,   "Zone pivot left",  minval = 2, maxval = 50,   group = "XAU2 · SR Zones", display = display.data_window)
x2_sr_right    = input.int(10,   "Zone pivot right", minval = 2, maxval = 50,   group = "XAU2 · SR Zones", display = display.data_window)
x2_sr_width    = input.float(0.5, "Zone width (x ATR)", minval = 0.05, step = 0.05, group = "XAU2 · SR Zones", display = display.data_window)
x2_sr_maxZone  = input.int(8,    "Max zones", minval = 1, maxval = 30,          group = "XAU2 · SR Zones", display = display.data_window)
x2_sr_showOn   = input.bool(true, "Hien thi S/R zones",                         group = "XAU2 · SR Zones", display = display.data_window)

// FVG (Fair Value Gap) - rieng toggle, test duoc doc lap
x2_fvg_showOn = input.bool(true,  "Hien thi FVG",                    group = "XAU2 · FVG", display = display.data_window)
x2_fvg_minAtr = input.float(0.3,  "FVG toi thieu (x ATR)", minval = 0.05, step = 0.05, group = "XAU2 · FVG", display = display.data_window)
x2_fvg_max    = input.int(20,     "FVG toi da", minval = 1, maxval = 50,        group = "XAU2 · FVG", display = display.data_window)
x2_fvg_life   = input.int(100,    "FVG toi da (nen)", minval = 10, maxval = 500, group = "XAU2 · FVG", display = display.data_window)

// Order Block - rieng toggle, test duoc doc lap
x2_ob_showOn = input.bool(true, "Hien thi Order Block",             group = "XAU2 · Order Block", display = display.data_window)
x2_ob_max    = input.int(20,    "Order Block toi da", minval = 1, maxval = 50,  group = "XAU2 · Order Block", display = display.data_window)

// Candle Patterns
x2_cp_pinRatio = input.float(2.0, "Pin bar ratio (wick/body)", minval = 1.0, step = 0.1, group = "XAU2 · Candle Patterns", display = display.data_window)
x2_cp_engulf   = input.bool(true, "Engulfing",     group = "XAU2 · Candle Patterns", display = display.data_window)
x2_cp_pin      = input.bool(true, "Pin Bar",       group = "XAU2 · Candle Patterns", display = display.data_window)
x2_cp_disp     = input.bool(true, "Displacement",  group = "XAU2 · Candle Patterns", display = display.data_window)
x2_cp_dispAtr  = input.float(1.5, "Displacement: body >= ATR x", minval = 0.5, step = 0.1, group = "XAU2 · Candle Patterns", display = display.data_window)
x2_cp_rej      = input.bool(true, "Rejection Candle", group = "XAU2 · Candle Patterns", display = display.data_window)

// Indicators - Trend (EMA stack)
x2_emaFast = input.int(20,  "EMA fast",  minval = 2,  maxval = 500, group = "XAU2 · Indicators", display = display.data_window)
x2_emaMid  = input.int(50,  "EMA mid",   minval = 5,  maxval = 500, group = "XAU2 · Indicators", display = display.data_window)
x2_emaSlow = input.int(200, "EMA slow",  minval = 10, maxval = 500, group = "XAU2 · Indicators", display = display.data_window)

// Indicators - Volatility / Momentum / Volume
x2_atrLen     = input.int(14,    "ATR length",     minval = 1,  maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_rsiLen     = input.int(14,    "RSI length",     minval = 2,  maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_rsiOb      = input.float(70,  "RSI overbought", minval = 50, maxval = 99, group = "XAU2 · Indicators", display = display.data_window)
x2_rsiOs      = input.float(30,  "RSI oversold",   minval = 1,  maxval = 50, group = "XAU2 · Indicators", display = display.data_window)
x2_macdF      = input.int(12,    "MACD fast",   minval = 2, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_macdS      = input.int(26,    "MACD slow",   minval = 5, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_macdSigLen = input.int(9,     "MACD signal", minval = 1, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_dmiLen     = input.int(14,    "DMI / ADX length",      minval = 2, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_dmiSmooth  = input.int(14,    "ADX smoothing",         minval = 2, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_adxMin     = input.float(20,  "ADX nguong manh xu huong", minval = 0.0, maxval = 100.0, step = 1.0, group = "XAU2 · Indicators", display = display.data_window)
x2_bbLen      = input.int(20,    "Bollinger length", minval = 2, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_bbMult     = input.float(2.0, "Bollinger mult",   minval = 0.5, step = 0.1, group = "XAU2 · Indicators", display = display.data_window)
x2_rvLen      = input.int(20,    "RelVol window (nen)", minval = 2, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)
x2_rvMin      = input.float(1.2, "RelVol nguong",       minval = 0.5, step = 0.1, group = "XAU2 · Indicators", display = display.data_window)
x2_obvLen     = input.int(20,    "OBV slope window (nen)", minval = 2, maxval = 200, group = "XAU2 · Indicators", display = display.data_window)

// Volume - VSA/Wyckoff configuration (dong bo TM VSA Wyckoff)
x2_vol_maLen  = input.int(20,    "Cua so Volume MA (Wilder RMA)", minval = 5, maxval = 100, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_showMA = input.bool(true, "Hien Volume MA", group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_spikeR = input.float(2.2, "TIM - cot dot bien (ratio)", minval = 1.5, step = 0.1, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_rVH    = input.float(1.8, "VeryHigh (ratio)", minval = 1.0, step = 0.1, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_rH     = input.float(1.2, "High (ratio)",     minval = 0.8, step = 0.1, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_rN     = input.float(0.8, "Normal (ratio)",   minval = 0.4, step = 0.1, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_rL     = input.float(0.4, "Low (ratio)",      minval = 0.1, step = 0.1, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_purWin = input.int(20,    "Cua so dem cot TIM (dashboard)", minval = 5, maxval = 100, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_min    = input.float(0.0, "Volume toi thieu tuyet doi (0 = tat)", minval = 0.0, group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_sessOn = input.bool(false, "Loc phien giao dich", group = "XAU2 · Volume VSA", display = display.data_window)
x2_vol_sess   = input.session("0800-1600", "Phien Volume", group = "XAU2 · Volume VSA", display = display.data_window)
// 2 nhom múi giờ (xem parts/10_config.pine): "của bạn" = loc phien 0800-1600; "NY" = nhan dien phien A/London/NY.
// Ca 2 deu truyen tz tuong minh vao time(); doi chart TradingView sang UTC+7 chi doi hien thi, khong doi tinh toan.
x2_vol_tz     = input.string("Asia/Ho_Chi_Minh", "Múi giờ phiên của bạn", options = ["Asia/Ho_Chi_Minh", "Asia/Singapore", "Asia/Tokyo", "Asia/Bangkok", "UTC", "Europe/London", "America/New_York", "America/Los_Angeles"], group = "XAU2 · Volume VSA", display = display.data_window)

// MTF Context (v2 §4): Context TF (H4/D/W/M) + Setup TF (H1/M15), entry = chart TF
x2_ctxTf     = input.timeframe("D",    "Context TF (H4/D/W/M)", options = ["240", "D", "W", "M"], group = "XAU2 · MTF Context", display = display.data_window)
x2_ctxLen    = input.int(200, "Context EMA length", minval = 10, maxval = 500, group = "XAU2 · MTF Context", display = display.data_window)
x2_setupTf   = input.timeframe("60",   "Setup TF (H1/M15)", options = ["15", "60"], group = "XAU2 · MTF Context", display = display.data_window)
x2_setupLen  = input.int(50,  "Setup EMA length",   minval = 5, maxval = 500, group = "XAU2 · MTF Context", display = display.data_window)
x2_htfFilter = input.bool(true, "Loc theo Setup TF", group = "XAU2 · MTF Context", display = display.data_window)
x2_htfVetoOn = input.bool(true, "HTF VETO - chan lenh khi Context doi lap (khong cho LTF override)", group = "XAU2 · MTF Context", display = display.data_window)

// Session
x2_sessTz = input.string("America/New_York", "Múi giờ thị trường (NY)", options = ["America/New_York", "Europe/London", "Asia/Ho_Chi_Minh", "Asia/Tokyo", "UTC"], group = "XAU2 · Session", display = display.data_window)

// Scoring weights (11 nhom, tong mac dinh = 100)
x2_w_trend   = input.float(15, "W: Trend (EMA stack)",   minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_struct  = input.float(15, "W: Structure",           minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_liq     = input.float(12, "W: Liquidity (sweep/TL)", minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_loc     = input.float(8,  "W: Location (VWAP/day)", minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_sr      = input.float(10, "W: S/R + FVG + OB",      minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_candle  = input.float(10, "W: Candle",              minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_vol     = input.float(8,  "W: Volume",              minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_atr     = input.float(7,  "W: Volatility",          minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_mom     = input.float(7,  "W: Momentum",            minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_sess    = input.float(4,  "W: Session",             minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)
x2_w_mtf     = input.float(4,  "W: MTF alignment",       minval = 0, step = 1, group = "XAU2 · Scoring Weights", display = display.data_window)

// Score thresholds
x2_scr_noTrade = input.int(49, "Score <= NO TRADE", minval = 0, maxval = 99, group = "XAU2 · Score Thresholds", display = display.data_window)
x2_scr_weak    = input.int(64, "Score <= WEAK",     minval = 1, maxval = 99, group = "XAU2 · Score Thresholds", display = display.data_window)
x2_scr_setup   = input.int(74, "Score <= SETUP",    minval = 1, maxval = 99, group = "XAU2 · Score Thresholds", display = display.data_window)
x2_scr_strong  = input.int(84, "Score <= STRONG",   minval = 1, maxval = 99, group = "XAU2 · Score Thresholds", display = display.data_window)

// Risk / TP / SL
x2_sl_atrMul = input.float(1.5, "SL = ATR x",        minval = 0.1, step = 0.1, group = "XAU2 · Risk", display = display.data_window)
x2_sl_swing  = input.int(10,    "Swing lookback SL",  minval = 2, maxval = 100, group = "XAU2 · Risk", display = display.data_window)
x2_sl_padAtr = input.float(0.2, "Dem sau swing (x ATR)", minval = 0, step = 0.05, group = "XAU2 · Risk", display = display.data_window)
x2_sl_minAtr = input.float(0.5, "SL min (x ATR)",     minval = 0.1, step = 0.1, group = "XAU2 · Risk", display = display.data_window)
x2_sl_maxAtr = input.float(3.0, "SL max (x ATR)",     minval = 0.5, step = 0.1, group = "XAU2 · Risk", display = display.data_window)
x2_rr1       = input.float(1.0, "TP1 (R)",            minval = 0.1, step = 0.1, group = "XAU2 · Risk", display = display.data_window)
x2_rr2       = input.float(2.0, "TP2 (R)",            minval = 0.1, step = 0.1, group = "XAU2 · Risk", display = display.data_window)
x2_rr3       = input.float(3.0, "TP3 (R)",            minval = 0.1, step = 0.1, group = "XAU2 · Risk", display = display.data_window)
x2_rrMin     = input.float(1.5, "RR toi thieu",       minval = 0, step = 0.1,  group = "XAU2 · Risk", display = display.data_window)
x2_maxDay    = input.int(3,     "Lenh toi da / ngay",  minval = 1, group = "XAU2 · Risk", display = display.data_window)
x2_coolBars  = input.int(10,    "Cooldown (nen)",      minval = 0, group = "XAU2 · Risk", display = display.data_window)

// Display (master switch chuan parts-xau/80_viz.pine)
x2_showViz  = input.bool(true, "Tat toan bo hien thi (master)", group = "XAU2 · Display", display = display.data_window)
x2_cBull    = input.color(color.new(#089981, 0), "Mau LONG",  group = "XAU2 · Display", inline = "clr", display = display.data_window)
x2_cBear    = input.color(color.new(#f23645, 0), "Mau SHORT", group = "XAU2 · Display", inline = "clr", display = display.data_window)
x2_showSig  = input.bool(true, "Nhan Entry (LONG/SHORT)", group = "XAU2 · Display", display = display.data_window)
x2_showHit  = input.bool(true, "Nhan cham TP/SL",   group = "XAU2 · Display", display = display.data_window)
x2_showZone = input.bool(true, "Ve vung SL/TP",     group = "XAU2 · Display", display = display.data_window)
x2_zoneLen  = input.int(30, "Do dai vung (nen)", minval = 1, maxval = 300, group = "XAU2 · Display", display = display.data_window)
x2_showEma  = input.bool(true, "EMA 20/50/200 tren gia", group = "XAU2 · Display", display = display.data_window)
// Moi loai ve co checkbox rieng (truoc day gop trong x2_showLvl -> kho izol loi chart bi thu be)
x2_showPd  = input.bool(true, "Duong PDH / PDL",    group = "XAU2 · Display", display = display.data_window)
x2_showPw  = input.bool(true, "Duong PWH / PWL",    group = "XAU2 · Display", display = display.data_window)
x2_showSess = input.bool(true, "Duong Session Hi / Lo", group = "XAU2 · Display", display = display.data_window)
x2_showPriceZones = input.bool(true, "Zone S/R + FVG + OB", group = "XAU2 · Display", display = display.data_window)
x2_showTl  = input.bool(true, "Trendline 2 diem",   group = "XAU2 · Display", display = display.data_window)
x2_showVwap = input.bool(true, "VWAP tren gia", group = "XAU2 · Display", display = display.data_window)
x2_showVol  = input.bool(true, "Histogram Volume", group = "XAU2 · Display", display = display.data_window)
x2_showDash = input.bool(true, "Dashboard", group = "XAU2 · Display", display = display.data_window)
x2_dashSize = input.string("Small", "Dash size", options = ["Tiny", "Small", "Normal"], group = "XAU2 · Display", display = display.data_window)
