// =============================================================================
//  L7 - MTF CONTEXT  (v2 §4)
//  Context TF (H4/D/W/M) + Setup TF (H1/M15); entry = chart TF (M5/M15).
//  Chi tinh bias o day - cong gate (VETO/Setup) nam o 80_scoring_risk sau khi
//  co diem so, de khong dung lai thu tu (score -> dir -> gate).
//  request.security [1] + lookahead_on -> khong nhin tuong lai.
// =============================================================================

float pa_ctxEma = request.security(syminfo.tickerid, pa_ctxTf, ta.ema(close, pa_ctxLen)[1], lookahead = barmerge.lookahead_on)
int   pa_ctxDir = not na(pa_ctxEma) ? (close > pa_ctxEma ? 1 : -1) : 0

float pa_setupEma = request.security(syminfo.tickerid, pa_setupTf, ta.ema(close, pa_setupLen)[1], lookahead = barmerge.lookahead_on)
int   pa_setupDir = not na(pa_setupEma) ? (close > pa_setupEma ? 1 : -1) : 0

// MTF alignment score: binh quan 2 bias (co the dung cho trong so)
float pa_gMtfBias = (float(pa_ctxDir) + float(pa_setupDir)) / 2.0
