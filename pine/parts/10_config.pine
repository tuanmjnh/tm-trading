// =============================================================================
//  LAYER 1 - CONFIG : chi khai bao input, khong chua logic
//  Moi module moi them o day 3 input (bat / tham so / trong so)
//
//  HAI LUI Y VE CACH VIET (ca hai da lam Pine bao loi nen dung ngay tu dau):
//    1. `group` phai la const string -> ghi truc tiep, khong dung bien.
//    2. KHONG tach mot bieu thuc input.* qua nhieu dong. Pine yeu cau `options`
//       la const string[]; tach dong se lam parser ho, bao CE10156 o dau "]".
//       Giu moi lenh input.* tren MOT dong du co dai.
// =============================================================================

// -----------------------------------------------------------------------------
//  CHUNG
// -----------------------------------------------------------------------------
tm_confirmOnly = input.bool(true, "Chi tin hieu tren nen da dong (khong repaint)", group = "TM · Chung", tooltip = "BAT = chi phat khi nen dong. TAT = phat ngay tren nen dang chay (co the repait).", display = display.data_window)
tm_alertMode   = input.string("All", "Che do alert", options = ["All", "Entry only", "TP/SL only"], group = "TM · Chung", display = display.data_window)
tm_payloadMode = input.string("Full", "Do dai payload webhook", options = ["Full", "Slim", "Off"], group = "TM · Chung", tooltip = "Slim = bo confidence/module de ngan tran gioi han 4096 ky tu cua TradingView.", display = display.data_window)

// -----------------------------------------------------------------------------
//  MODULE 1 - TREND FLIP (Supertrend)
// -----------------------------------------------------------------------------
tm_m1_on      = input.bool(true, "Bat module", group = "TM · M1 Trend flip", display = display.data_window)
tm_m1_stAtr   = input.float(3.0, "Supertrend ATR multiplier", minval = 0.5, step = 0.1, group = "TM · M1 Trend flip", display = display.data_window)
// ta.supertrend() yeu cau tham so `atrPeriod` la SIMPLE INT - truyen bien
// series float (nhu ATR) se bi bao CE10123. Phai so 1 chu ky ATR rieng.
tm_m1_stAtrLen = input.int(10, "Supertrend ATR period", minval = 1, group = "TM · M1 Trend flip", display = display.data_window)
tm_m1_w       = input.float(1.0, "Trong so", minval = 0.0, step = 0.1, group = "TM · M1 Trend flip", display = display.data_window)

// -----------------------------------------------------------------------------
//  MODULE 2 - DIVERGENCE (RSI)
// -----------------------------------------------------------------------------
tm_m2_on     = input.bool(true, "Bat module", group = "TM · M2 RSI divergence", display = display.data_window)
tm_m2_rsiLen = input.int(14, "RSI length", minval = 2, group = "TM · M2 RSI divergence", display = display.data_window)
tm_m2_swLen  = input.int(3, "Pivot length", minval = 1, maxval = 20, group = "TM · M2 RSI divergence", display = display.data_window)
tm_m2_hold   = input.int(4, "So nen giu tin hieu", minval = 1, maxval = 20, group = "TM · M2 RSI divergence", display = display.data_window)
tm_m2_w      = input.float(1.2, "Trong so", minval = 0.0, step = 0.1, group = "TM · M2 RSI divergence", display = display.data_window)

// -----------------------------------------------------------------------------
//  MODULE 3 - BOLLINGER REVERSION
// -----------------------------------------------------------------------------
tm_m3_on   = input.bool(true, "Bat module", group = "TM · M3 Bollinger reversion", display = display.data_window)
tm_m3_len  = input.int(20, "BB length", minval = 2, group = "TM · M3 Bollinger reversion", display = display.data_window)
tm_m3_mult = input.float(2.0, "BB multiplier", minval = 0.1, step = 0.1, group = "TM · M3 Bollinger reversion", display = display.data_window)
tm_m3_look = input.int(3, "So nen quet chan gia", minval = 1, maxval = 10, group = "TM · M3 Bollinger reversion", display = display.data_window)
tm_m3_w    = input.float(0.8, "Trong so", minval = 0.0, step = 0.1, group = "TM · M3 Bollinger reversion", display = display.data_window)

// -----------------------------------------------------------------------------
//  MODULE 4 - PRICE ACTION
// -----------------------------------------------------------------------------
tm_m4_on     = input.bool(true, "Bat module", group = "TM · M4 Price action", display = display.data_window)
tm_m4_engulf = input.bool(true, "Engulfing", group = "TM · M4 Price action", display = display.data_window)
tm_m4_pin    = input.bool(true, "Pin bar", group = "TM · M4 Price action", display = display.data_window)
tm_m4_pinR   = input.float(2.2, "Pin bar ratio", minval = 1.0, step = 0.1, group = "TM · M4 Price action", display = display.data_window)
tm_m4_hold   = input.int(2, "So nen giu tin hieu", minval = 1, maxval = 10, group = "TM · M4 Price action", display = display.data_window)
tm_m4_w      = input.float(0.9, "Trong so", minval = 0.0, step = 0.1, group = "TM · M4 Price action", display = display.data_window)

// -----------------------------------------------------------------------------
//  MODULE 5 - EMA CROSS
// -----------------------------------------------------------------------------
tm_m5_on   = input.bool(true, "Bat module", group = "TM · M5 EMA cross", display = display.data_window)
tm_m5_fast = input.int(21, "EMA nhanh", minval = 1, group = "TM · M5 EMA cross", display = display.data_window)
tm_m5_slow = input.int(55, "EMA cham", minval = 2, group = "TM · M5 EMA cross", display = display.data_window)
tm_m5_hold = input.int(3, "So nen giu tin hieu", minval = 1, maxval = 20, group = "TM · M5 EMA cross", display = display.data_window)
tm_m5_w    = input.float(0.7, "Trong so", minval = 0.0, step = 0.1, group = "TM · M5 EMA cross", display = display.data_window)

// -----------------------------------------------------------------------------
//  BO LOC
// -----------------------------------------------------------------------------
tm_flt_htfOn  = input.bool(true, "Loc xu huong TF cao", group = "TM · Bo loc", display = display.data_window)
tm_flt_htf    = input.timeframe("60", "Timeframe cao hon", group = "TM · Bo loc", display = display.data_window)
tm_flt_htfLen = input.int(50, "EMA tren TF cao", minval = 1, group = "TM · Bo loc", display = display.data_window)
tm_flt_htfDir = input.string("Cung huong", "Quy tac", options = ["Cung huong", "Chi chan thoi trong", "Tat"], group = "TM · Bo loc", display = display.data_window)

tm_flt_sessOn = input.bool(false, "Loc theo phien giao dich", group = "TM · Bo loc", display = display.data_window)
tm_flt_sess   = input.session("0800-1600", "Phien", group = "TM · Bo loc", display = display.data_window)
// Pine KHONG co input.timezone(). Dung input.string voi danh sach moc gio de chon.
// Luu y: `options` phai nam tren MOT DONG - tach nhieu dong se lam Pine parse sai
// mang const va bao loi CE10156.
// CO 2 NHOM MUI GIO (ca 2 deu chuyen vao time() tuong minh, KHONG doc chart timezone):
//  - "Múi giờ phiên của bạn" (mac dinh Asia/Ho_Chi_Minh): loc khung gio giao dich 0800-1600 cua ban.
//  - "Múi giờ thị trường (NY)" (mac dinh America/New_York): nhan dien phien A/London/NY (f_sess*).
// Doi cai dat chart TradingView sang UTC+7 chi anh huong HIENTHI truc thoi gian, khong doi tinh toan.
tm_flt_tz     = input.string("Asia/Ho_Chi_Minh", "Múi giờ phiên của bạn", options = ["Asia/Ho_Chi_Minh", "Asia/Singapore", "Asia/Tokyo", "Asia/Bangkok", "UTC", "Europe/London", "America/New_York", "America/Los_Angeles"], group = "TM · Bo loc", display = display.data_window)

tm_flt_volOn  = input.bool(false, "Loc bien do (ATR toi thieu)", group = "TM · Bo loc", display = display.data_window)
tm_flt_volMin = input.float(0.2, "ATR toi thieu % gia", minval = 0.0, step = 0.05, group = "TM · Bo loc", display = display.data_window)
tm_flt_vsaOn   = input.bool(false, "Loc theo VSA volume", group = "TM · Bo loc", display = display.data_window, tooltip = "Chi phep lenh khi volume bar tin hieu >= he so x Volume MA (xac nhan pha co luong that).")
tm_flt_vsaMinR = input.float(1.2, "VSA volume toi thieu (× MA)", minval = 0.1, step = 0.1, group = "TM · Bo loc", display = display.data_window)
tm_flt_vsaLen  = input.int(20, "VSA do dai Volume MA", minval = 5, maxval = 500, group = "TM · Bo loc", display = display.data_window)

tm_flt_maxDay = input.int(4, "Toi da bao lenh moi ngay", minval = 1, group = "TM · Bo loc", display = display.data_window)
tm_flt_cool   = input.int(10, "Nen cho giua hai lenh", minval = 0, group = "TM · Bo loc", display = display.data_window)
tm_confMin    = input.float(0.55, "Confidence toi thieu", minval = 0.0, maxval = 1.0, step = 0.05, group = "TM · Bo loc", display = display.data_window)

// -----------------------------------------------------------------------------
//  RISK
// -----------------------------------------------------------------------------
tm_slMode   = input.string("Blend", "Cach tinh SL", options = ["ATR", "Structure", "Blend"], group = "TM · Risk / TP / SL", display = display.data_window)
tm_slAtrMul = input.float(1.5, "SL = ATR × hệ số", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_slSwing  = input.int(10, "Swing lookback cho SL", minval = 2, maxval = 100, group = "TM · Risk / TP / SL", display = display.data_window)
tm_slPadAtr = input.float(0.2, "Đệm sau swing (× ATR)", minval = 0.0, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_slMinAtr = input.float(0.5, "Kẹp dưới (× ATR)", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_slMaxAtr = input.float(3.0, "Kẹp trên (× ATR)", minval = 0.5, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)

tm_tpMode = input.string("Ladder", "Cach tinh TP", options = ["Ladder", "Simple"], group = "TM · Risk / TP / SL", display = display.data_window)
tm_rr1    = input.float(1.0, "TP1 (R)", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_rr2    = input.float(2.0, "TP2 (R)", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_rr3    = input.float(3.0, "TP3 (R)", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_rrMin  = input.float(0.0, "RR tối thiểu để chấp nhận", minval = 0.0, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)

tm_beOn     = input.bool(true, "Breakeven", group = "TM · Risk / TP / SL", display = display.data_window)
tm_beAtR    = input.float(1.0, "Bật BE tại (R)", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_beOffset = input.float(0.05, "Lệch BE (× ATR)", minval = 0.0, step = 0.01, group = "TM · Risk / TP / SL", display = display.data_window)

tm_trailOn    = input.bool(true, "Trailing stop", group = "TM · Risk / TP / SL", display = display.data_window)
tm_trailStart = input.float(1.5, "Bắt đầu trail sau (R)", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_trailAtr   = input.float(1.2, "Trailing = ATR × hệ số", minval = 0.1, step = 0.1, group = "TM · Risk / TP / SL", display = display.data_window)
tm_maxHold    = input.int(200, "Đóng vị thế sau (nến)", minval = 5, group = "TM · Risk / TP / SL", display = display.data_window)

// -----------------------------------------------------------------------------
//  SESSION - moc gio cho dashboard (chuan parts-xau/80_viz.pine)
// -----------------------------------------------------------------------------
tm_sessTz   = input.string("America/New_York", "Múi giờ thị trường (NY)", options = ["America/New_York", "Europe/London", "Asia/Ho_Chi_Minh", "Asia/Tokyo", "UTC"], group = "TM · Session", display = display.data_window)

// -----------------------------------------------------------------------------
//  HIEN THI
// -----------------------------------------------------------------------------
tm_showViz  = input.bool(true, "Tắt toàn bộ hiển thị (master)", group = "TM · Hien thi", display = display.data_window)
tm_cBull     = input.color(color.new(#089981, 0), "Màu BUY", group = "TM · Hien thi", inline = "clr", display = display.data_window)
tm_cBear     = input.color(color.new(#f23645, 0), "Màu SELL", group = "TM · Hien thi", inline = "clr", display = display.data_window)
tm_showSig   = input.bool(true, "Nhan BUY/SELL", group = "TM · Hien thi", display = display.data_window)
tm_showZone  = input.bool(true, "Vẽ vùng TP/SL", group = "TM · Hien thi", display = display.data_window)
tm_zoneLen   = input.int(20, "Độ dài vùng (nến)", minval = 1, maxval = 200, group = "TM · Hien thi", display = display.data_window)
tm_showHist  = input.bool(true, "Giữ lịch sử plan đã đóng", group = "TM · Hien thi", display = display.data_window)
tm_keepPlans = input.int(10, "Số lệnh quá khứ vẽ lại", minval = 0, maxval = 50, group = "TM · Hien thi", display = display.data_window, tooltip = "So lenh da dong duoc ve lai tren chart (box tu lenh den thoat + nhan R). 0 = tat lich su.")
tm_showVol   = input.bool(true, "Histogram Volume", group = "TM · Hien thi", display = display.data_window)
tm_showVolMA = input.bool(true, "Volume MA", group = "TM · Hien thi", display = display.data_window)
tm_showDash  = input.bool(true, "Dashboard", group = "TM · Hien thi", display = display.data_window)
tm_dashSize  = input.string("Small", "Kích thước", options = ["Tiny", "Small", "Normal"], group = "TM · Hien thi", display = display.data_window)
