// =============================================================================
//  LAYER 5 - STATE MACHINE
//  Noi nen da dong / chay, quan ly viethe, phat su kien cho tang viz + alerts.
//  Day la tang duy nhat duoc phep tao va xoa bien `var`.
//
//  LUUU Y QUAN TRONG: vie dong vi the duoc HOAN TOAN tri hoan den bar ke tiep
//  (tm_needReset). Neu reset ngay trong chinh bar do, tang 60_viz va 70_alerts
//  se khong con doc duoc gia TP/SL de ve va phong alert.
// =============================================================================

tm_okBar = tm_confirmOnly ? barstate.isconfirmed : true

// -----------------------------------------------------------------------------
//  Trang thai viethe
// -----------------------------------------------------------------------------
var int   tm_posDir   = 0
var float tm_posEntry = na
var float tm_posSl    = na
var float tm_posTp1   = na
var float tm_posTp2   = na
var float tm_posTp3   = na
var float tm_posRisk  = na
var int   tm_posBars  = 0
var int   tm_posStage = 0
var int   tm_posConf  = 0
var int   tm_posBar   = na
var bool  tm_needReset = false

var int   tm_statTrades = 0
var int   tm_statWins   = 0
var int   tm_statLosses = 0

// Thong so viethe vua dong, dung cho tang viz ve lich su.
var float tm_xEntry = na
var float tm_xSl    = na
var int   tm_xDir   = 0
var int   tm_xBar   = na
var float tm_xExit  = na
var float tm_xR     = na

// -----------------------------------------------------------------------------
//  Su kien trong bar (consumed boi 60_viz va 70_alerts)
// -----------------------------------------------------------------------------
var bool tm_evEntry = false
var int   tm_evTp    = 0
var bool tm_evSl    = false
var bool tm_evClose = false

tm_evEntry := false
tm_evTp    := 0
tm_evSl    := false
tm_evClose := false

// -----------------------------------------------------------------------------
//  1. Thi tri khoi vi the da dong o bar truoc
// -----------------------------------------------------------------------------
if tm_needReset
    tm_needReset := false
    tm_posDir    := 0
    tm_posBars   := 0
    tm_posStage  := 0
    tm_posEntry  := na
    tm_posSl     := na
    tm_posTp1    := na
    tm_posTp2    := na
    tm_posTp3    := na
    tm_posRisk   := na
    tm_posBar    := na

// -----------------------------------------------------------------------------
//  2. Quan ly vi the dang mo
// -----------------------------------------------------------------------------
if tm_posDir != 0
    bool isUp = tm_posDir == 1

    // --- BE / trailing: dung high[1]/low[1] de khong nhin truoc phien ban ---
    if tm_beOn
        float beR   = tm_posRisk * tm_beAtR
        bool   beHit = isUp ? high[1] >= tm_posEntry + beR : low[1] <= tm_posEntry - beR
        if beHit
            float beLv = tm_posEntry + tm_posDir * tm_atr * tm_beOffset
            tm_posSl := isUp ? math.max(tm_posSl, beLv) : math.min(tm_posSl, beLv)

    if tm_trailOn
        float trR    = tm_posRisk * tm_trailStart
        bool   trHit = isUp ? high[1] >= tm_posEntry + trR : low[1] <= tm_posEntry - trR
        if trHit
            float trLv = isUp ? high[1] - tm_trailAtr * tm_atr : low[1] + tm_trailAtr * tm_atr
            tm_posSl := isUp ? math.max(tm_posSl, trLv) : math.min(tm_posSl, trLv)

    // --- Kiem tra cham muc tien ---
    //  OHLC khong cho biet thu tu high/low -> gia cao cham ca SL va TP cung bar
    //  thi tinh la SL truoc (thi lanh, tranh uoc luong khi ban khong that).
    float t1 = tm_posStage < 1 ? tm_posTp1 : na
    float t2 = tm_posStage < 2 ? tm_posTp2 : na
    float t3 = tm_posStage < 3 ? tm_posTp3 : na

    bool hitSl = isUp ? low  <= tm_posSl : high >= tm_posSl
    bool hit1  = not na(t1) and (isUp ? high >= t1 : low  <= t1)
    bool hit2  = not na(t2) and (isUp ? high >= t2 : low  <= t2)
    bool hit3  = not na(t3) and (isUp ? high >= t3 : low  <= t3)

    bool closed = false

    if hitSl and (hit1 or hit2 or hit3)
        closed     := true
        tm_evSl    := true
        tm_evClose := true
        tm_statLosses += 1
    else if hit1
        tm_evTp := 1
        tm_posStage := 1
        if tm_tpMode == "Simple"
            closed     := true
            tm_evTp    := 4
            tm_evClose := true
            tm_statWins += 1
    else if hit2
        tm_evTp := 2
        tm_posStage := 2
    else if hit3
        tm_evTp := 3
        tm_posStage := 3
        tm_statWins += 1

    if not closed and tm_posBars > tm_maxHold
        closed     := true
        tm_evClose := true

    if closed
        tm_statTrades += 1
        tm_xEntry     := tm_posEntry
        tm_xSl        := tm_posSl
        tm_xDir       := tm_posDir
        tm_xBar       := tm_posBar
        tm_xExit      := tm_evSl ? tm_posSl : ((tm_evTp == 1 or tm_evTp == 4) ? tm_posTp1 : (tm_evTp == 2 ? tm_posTp2 : (tm_evTp == 3 ? tm_posTp3 : close)))
        tm_xR         := not na(tm_posRisk) and tm_posRisk > 0 ? (tm_xExit - tm_posEntry) * tm_posDir / tm_posRisk : na
        tm_needReset  := true

// -----------------------------------------------------------------------------
//  3. Mo vi the moi
// -----------------------------------------------------------------------------
if tm_okBar and tm_signal and tm_posDir == 0
    tm_posDir    := tm_plan.dir
    tm_posEntry  := tm_plan.entry
    tm_posSl     := tm_plan.sl
    tm_posTp1    := tm_plan.tp1
    tm_posTp2    := tm_plan.tp2
    tm_posTp3    := tm_plan.tp3
    tm_posRisk   := tm_plan.risk
    tm_posBars   := 0
    tm_posStage  := 0
    tm_posConf   := int(math.round(tm_conf * 100))
    tm_posBar    := bar_index

    tm_evEntry   := true
    tm_dayCount  := tm_dayCount + 1
    tm_barsSince := 0

// -----------------------------------------------------------------------------
//  4. Dem bar (sau khi mo len chay 1 lan o bar goc)
// -----------------------------------------------------------------------------
if tm_posDir != 0 and not tm_evEntry and not tm_needReset
    tm_posBars += 1

// @part skip:indicator
// =============================================================================
//  BACKTEST BRIDGE - chi sinh ra o ban strategy
// =============================================================================
if tm_okBar and tm_evEntry
    if tm_plan.dir == 1
        strategy.entry("Long", strategy.long)
    else
        strategy.entry("Short", strategy.short)

if tm_posDir != 0
    tm_en = tm_posDir == 1 ? "Long" : "Short"
    strategy.exit("TP1", from_entry = tm_en, stop = tm_posSl, qty_percent = 30, limit = tm_posTp1)
    strategy.exit("TP2", from_entry = tm_en, stop = tm_posSl, qty_percent = 40, limit = tm_posTp2)
    strategy.exit("TP3", from_entry = tm_en, stop = tm_posSl, qty_percent = 30, limit = tm_posTp3)

if tm_evClose
    strategy.close_all()
