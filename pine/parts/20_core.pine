// =============================================================================
//  LAYER 2 - CORE : tien ich thuan, ATR, pivot/swing, phien giao dich
//  Khong duoc phep phu thuoc vao module tin hieu cu the nao.
// =============================================================================

// f_clamp / f_fmtPx / f_isNewDay - shared (pine/shared/common.pine)
f_tfMinutes() =>
    timeframe.in_seconds() / 60.0

// Giu 1 su kien trong `n` nen (chuyen thanh xung lien tuc de tinh diem tong hop).
f_pulse(bool ev, int n) =>
    var int cnt = 0
    cnt := ev ? n : math.max(0, cnt - 1)
    cnt > 0

// -----------------------------------------------------------------------------
//  Bien do - dung cho SL/TP (series float, khong gioi han)
// -----------------------------------------------------------------------------
tm_atr = ta.atr(14)

// -----------------------------------------------------------------------------
//  Volume VSA - Wilder MA (RMA), dung cho pane volume + filter VSA
// -----------------------------------------------------------------------------
tm_vol   = nz(volume)
tm_volMA = ta.rma(tm_vol, tm_flt_vsaLen)

// -----------------------------------------------------------------------------
//  Pivot / swing dung chung cho divergence va SL theo cau truc
// -----------------------------------------------------------------------------
tm_pivHigh = ta.pivothigh(high, tm_m2_swLen, tm_m2_swLen)
tm_pivLow  = ta.pivotlow(low,  tm_m2_swLen, tm_m2_swLen)

// -----------------------------------------------------------------------------
//  Swing tham bien cho SL (ta.lowest/ta.highest theo lookback)
// -----------------------------------------------------------------------------
tm_swingLow  = ta.lowest(low,  tm_slSwing)
tm_swingHigh = ta.highest(high, tm_slSwing)

// -----------------------------------------------------------------------------
//  EMA nhanh/cham cho module 5 + bias nen
// -----------------------------------------------------------------------------
tm_emaF = ta.ema(close, tm_m5_fast)
tm_emaS = ta.ema(close, tm_m5_slow)
