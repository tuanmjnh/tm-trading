// =============================================================================
//  L0 - CONFIG (Moi tinh nang co toggle rieng de kiem thu doc lap)
// =============================================================================

// General
tm_confirmOnly = input.bool(true,  "Chi tin hieu nen da dong (no-repaint)", group = "TM · Chung", display = display.data_window)
tm_payloadMode = input.string("Full", "Webhook payload", options = ["Full", "Slim", "Off"], group = "TM · Chung", display = display.data_window)

// Asset Profile (Phase 2)
tm_assetMode            = input.string("Auto", "Asset Profile", options = ["Auto", "XAU", "BTC", "ETH", "Liquid Altcoin", "High-Risk Altcoin", "Custom"], group = "TM · Asset Profile", display = display.data_window)
tm_cryptoSessionNeutral = input.bool(true, "Crypto 24/7: Session neutral (khong phat gio)", group = "TM · Asset Profile", display = display.data_window)
tm_minVolCheck          = input.bool(true, "Kiem tra thanh khoan toi thieu (Altcoin gate)", group = "TM · Asset Profile", display = display.data_window)

// Market Structure (BOS / CHoCH / MSS / Retest / Fail / Cont / Pull)
tm_ms_swLen      = input.int(5,    "Swing lookback (nen)", minval = 2, maxval = 20, group = "TM · Market Structure", display = display.data_window)
tm_ms_bosOn      = input.bool(true, "Hien thi BOS",                 group = "TM · Market Structure", display = display.data_window)
tm_ms_chochOn    = input.bool(true, "Hien thi CHoCH",               group = "TM · Market Structure", display = display.data_window)
tm_ms_mssOn      = input.bool(true, "Hien thi MSS (break + displ.)", group = "TM · Market Structure", display = display.data_window)
tm_ms_retestOn   = input.bool(true, "Phat hien Retest sau BOS",     group = "TM · Market Structure", display = display.data_window)
tm_ms_retestBars = input.int(10,    "Cua so retest (nen)", minval = 1, maxval = 100, group = "TM · Market Structure", display = display.data_window)
tm_ms_retestTol  = input.float(0.5, "Retest tolerance (x ATR)", minval = 0.0, step = 0.1, group = "TM · Market Structure", display = display.data_window)
tm_ms_failOn     = input.bool(true, "Phat hien Failed Breakout",    group = "TM · Market Structure", display = display.data_window)
tm_ms_failBars   = input.int(5,     "Cua so failed breakout (nen)", minval = 1, maxval = 50, group = "TM · Market Structure", display = display.data_window)
tm_ms_contOn     = input.bool(true, "Trend continuation (HH/LL)",   group = "TM · Market Structure", display = display.data_window)
tm_ms_pullOn     = input.bool(true, "Pullback ve EMA",              group = "TM · Market Structure", display = display.data_window)

// Liquidity & Market Location (PD/PW, Session HL, Eq, Sweep, Trendline)
tm_liq_eqTol   = input.float(0.05, "Equal Hi/Lo tolerance (x ATR)", minval = 0.0, step = 0.01, group = "TM · Liquidity", display = display.data_window)
tm_liq_sweepOn = input.bool(true,  "Hien thi Liquidity Sweep",      group = "TM · Liquidity", display = display.data_window)
tm_liq_pdOn    = input.bool(true,  "Hien thi PDH / PDL",            group = "TM · Liquidity", display = display.data_window)
tm_liq_pwOn    = input.bool(true,  "Hien thi PWH / PWL",            group = "TM · Liquidity", display = display.data_window)
tm_liq_sessOn  = input.bool(true,  "Hien thi Session High / Low",   group = "TM · Liquidity", display = display.data_window)
tm_liq_tlOn    = input.bool(true,  "Trendline 2 diem",              group = "TM · Liquidity", display = display.data_window)
tm_liq_tlTol   = input.float(0.25, "Trendline touch tolerance (x ATR)", minval = 0.05, step = 0.05, group = "TM · Liquidity", display = display.data_window)
tm_liq_tlMaxDev = input.float(10.0, "Trendline toi da xa gia (x ATR)", minval = 1.0, step = 1.0, group = "TM · Liquidity", display = display.data_window)

// S/R Zones
tm_sr_left     = input.int(10,   "Zone pivot left",  minval = 2, maxval = 50,   group = "TM · SR Zones", display = display.data_window)
tm_sr_right    = input.int(10,   "Zone pivot right", minval = 2, maxval = 50,   group = "TM · SR Zones", display = display.data_window)
tm_sr_width    = input.float(0.5, "Zone width (x ATR)", minval = 0.05, step = 0.05, group = "TM · SR Zones", display = display.data_window)
tm_sr_maxZone  = input.int(8,    "Max zones", minval = 1, maxval = 30,          group = "TM · SR Zones", display = display.data_window)
tm_sr_showOn   = input.bool(true, "Hien thi S/R zones",                         group = "TM · SR Zones", display = display.data_window)

// FVG (Fair Value Gap)
tm_fvg_showOn = input.bool(true,  "Hien thi FVG",                    group = "TM · FVG", display = display.data_window)
tm_fvg_minAtr = input.float(0.3,  "FVG toi thieu (x ATR)", minval = 0.05, step = 0.05, group = "TM · FVG", display = display.data_window)
tm_fvg_max    = input.int(20,     "FVG toi da", minval = 1, maxval = 50,        group = "TM · FVG", display = display.data_window)
tm_fvg_life   = input.int(100,    "FVG toi da (nen)", minval = 10, maxval = 500, group = "TM · FVG", display = display.data_window)

// Order Block
tm_ob_showOn = input.bool(true, "Hien thi Order Block",             group = "TM · Order Block", display = display.data_window)
tm_ob_max    = input.int(20,    "Order Block toi da", minval = 1, maxval = 50,  group = "TM · Order Block", display = display.data_window)
tm_ob_life   = input.int(150,   "Order Block toi da (nen)", minval = 10, maxval = 300, group = "TM · Order Block", display = display.data_window)

// Candle Patterns
tm_cp_pinRatio = input.float(2.0, "Pin bar ratio (wick/body)", minval = 1.0, step = 0.1, group = "TM · Candle Patterns", display = display.data_window)
tm_cp_engulf   = input.bool(true, "Engulfing",     group = "TM · Candle Patterns", display = display.data_window)
tm_cp_pin      = input.bool(true, "Pin Bar",       group = "TM · Candle Patterns", display = display.data_window)
tm_cp_disp     = input.bool(true, "Displacement",  group = "TM · Candle Patterns", display = display.data_window)
tm_cp_dispAtr  = input.float(1.5, "Displacement: body >= ATR x", minval = 0.5, step = 0.1, group = "TM · Candle Patterns", display = display.data_window)
tm_cp_rej      = input.bool(true, "Rejection Candle", group = "TM · Candle Patterns", display = display.data_window)

// Indicators - Trend (EMA stack)
tm_emaFast = input.int(20,  "EMA fast",  minval = 2,  maxval = 500, group = "TM · Indicators", display = display.data_window)
tm_emaMid  = input.int(50,  "EMA mid",   minval = 5,  maxval = 500, group = "TM · Indicators", display = display.data_window)
tm_emaSlow = input.int(200, "EMA slow",  minval = 10, maxval = 500, group = "TM · Indicators", display = display.data_window)

// Indicators - Volatility / Momentum / Volume
tm_atrLen     = input.int(14,    "ATR length",     minval = 1,  maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_rsiLen     = input.int(14,    "RSI length",     minval = 2,  maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_rsiOb      = input.float(70,  "RSI overbought", minval = 50, maxval = 99, group = "TM · Indicators", display = display.data_window)
tm_rsiOs      = input.float(30,  "RSI oversold",   minval = 1,  maxval = 50, group = "TM · Indicators", display = display.data_window)
tm_macdF      = input.int(12,    "MACD fast",   minval = 2, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_macdS      = input.int(26,    "MACD slow",   minval = 5, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_macdSigLen = input.int(9,     "MACD signal", minval = 1, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_dmiLen     = input.int(14,    "DMI / ADX length",      minval = 2, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_dmiSmooth  = input.int(14,    "ADX smoothing",         minval = 2, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_adxMin     = input.float(20,  "ADX nguong manh xu huong", minval = 0.0, maxval = 100.0, step = 1.0, group = "TM · Indicators", display = display.data_window)
tm_bbLen      = input.int(20,    "Bollinger length", minval = 2, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_bbMult     = input.float(2.0, "Bollinger mult",   minval = 0.5, step = 0.1, group = "TM · Indicators", display = display.data_window)
tm_rvLen      = input.int(20,    "RelVol window (nen)", minval = 2, maxval = 200, group = "TM · Indicators", display = display.data_window)
tm_rvMin      = input.float(1.2, "RelVol nguong",       minval = 0.5, step = 0.1, group = "TM · Indicators", display = display.data_window)
tm_obvLen     = input.int(20,    "OBV slope window (nen)", minval = 2, maxval = 200, group = "TM · Indicators", display = display.data_window)

// Volume - VSA configuration
tm_vol_maLen  = input.int(20,    "Cua so Volume MA (Wilder RMA)", minval = 5, maxval = 100, group = "TM · Volume VSA", display = display.data_window)
tm_vol_showMA = input.bool(true, "Hien Volume MA", group = "TM · Volume VSA", display = display.data_window)
tm_vol_spikeR = input.float(2.2, "TIM - cot dot bien (ratio)", minval = 1.5, step = 0.1, group = "TM · Volume VSA", display = display.data_window)
tm_vol_rVH    = input.float(1.8, "VeryHigh (ratio)", minval = 1.0, step = 0.1, group = "TM · Volume VSA", display = display.data_window)
tm_vol_rH     = input.float(1.2, "High (ratio)",     minval = 0.8, step = 0.1, group = "TM · Volume VSA", display = display.data_window)
tm_vol_rN     = input.float(0.8, "Normal (ratio)",   minval = 0.4, step = 0.1, group = "TM · Volume VSA", display = display.data_window)
tm_vol_rL     = input.float(0.4, "Low (ratio)",      minval = 0.1, step = 0.1, group = "TM · Volume VSA", display = display.data_window)
tm_vol_purWin = input.int(20,    "Cua so dem cot TIM (dashboard)", minval = 5, maxval = 100, group = "TM · Volume VSA", display = display.data_window)
tm_vol_min    = input.float(0.0, "Volume toi thieu tuyet doi (0 = tat)", minval = 0.0, group = "TM · Volume VSA", display = display.data_window)
tm_vol_sessOn = input.bool(false, "Loc phien giao dich", group = "TM · Volume VSA", display = display.data_window)
tm_vol_sess   = input.session("0800-1600", "Phien Volume", group = "TM · Volume VSA", display = display.data_window)
tm_vol_tz     = input.string("Asia/Ho_Chi_Minh", "Múi giờ phiên của bạn", options = ["Asia/Ho_Chi_Minh", "Asia/Singapore", "Asia/Tokyo", "Asia/Bangkok", "UTC", "Europe/London", "America/New_York", "America/Los_Angeles"], group = "TM · Volume VSA", display = display.data_window)

// MTF Context: Context TF + Setup TF, entry = chart TF
tm_ctxTf     = input.timeframe("D",    "Context TF (H1/H4/D/W/M)", options = ["60", "240", "D", "W", "M"], group = "TM · MTF Context", display = display.data_window)
tm_ctxLen    = input.int(200, "Context EMA length", minval = 10, maxval = 500, group = "TM · MTF Context", display = display.data_window)
tm_setupTf   = input.timeframe("60",   "Setup TF (M15/M30/H1/H4)", options = ["15", "30", "60", "240"], group = "TM · MTF Context", display = display.data_window)
tm_setupLen  = input.int(50,  "Setup EMA length",   minval = 5, maxval = 500, group = "TM · MTF Context", display = display.data_window)
tm_htfFilter = input.bool(true, "Loc theo Setup TF", group = "TM · MTF Context", display = display.data_window)
tm_htfVetoOn = input.bool(true, "HTF VETO - chan lenh khi Context doi lap", group = "TM · MTF Context", display = display.data_window)

// Session
tm_sessTz = input.string("America/New_York", "Múi giờ thị trường (NY)", options = ["America/New_York", "Europe/London", "Asia/Ho_Chi_Minh", "Asia/Tokyo", "UTC"], group = "TM · Session", display = display.data_window)

// Scoring weights (11 nhom, tong mac dinh = 100)
tm_w_trend   = input.float(15, "W: Trend (EMA stack)",   minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_struct  = input.float(15, "W: Structure",           minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_liq     = input.float(12, "W: Liquidity (sweep/TL)", minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_loc     = input.float(8,  "W: Location (VWAP/day)", minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_sr      = input.float(10, "W: S/R + FVG + OB",      minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_candle  = input.float(10, "W: Candle",              minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_vol     = input.float(8,  "W: Volume",              minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_atr     = input.float(7,  "W: Volatility",          minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_mom     = input.float(7,  "W: Momentum",            minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_sess    = input.float(4,  "W: Session",             minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)
tm_w_mtf     = input.float(4,  "W: MTF alignment",       minval = 0, step = 1, group = "TM · Scoring Weights", display = display.data_window)

// Score thresholds
tm_scr_noTrade = input.int(49, "Score <= NO TRADE", minval = 0, maxval = 99, group = "TM · Score Thresholds", display = display.data_window)
tm_scr_weak    = input.int(64, "Score <= WEAK",     minval = 1, maxval = 99, group = "TM · Score Thresholds", display = display.data_window)
tm_scr_setup   = input.int(74, "Score <= SETUP",    minval = 1, maxval = 99, group = "TM · Score Thresholds", display = display.data_window)
tm_scr_strong  = input.int(84, "Score <= STRONG",   minval = 1, maxval = 99, group = "TM · Score Thresholds", display = display.data_window)
tm_minQuality  = input.string("SETUP", "Cap do chat luong toi thieu (Gate)", options = ["WEAK", "SETUP", "STRONG", "A+"], group = "TM · Score Thresholds", display = display.data_window)

// Risk / TP / SL (P0 RR Fix: tach biet moc danh gia Target RR va nguong toi thieu)
tm_sl_atrMul   = input.float(1.5, "SL = ATR x",        minval = 0.1, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_sl_swing    = input.int(10,    "Swing lookback SL",  minval = 2, maxval = 100, group = "TM · Risk", display = display.data_window)
tm_sl_padAtr   = input.float(0.2, "Dem sau swing (x ATR)", minval = 0, step = 0.05, group = "TM · Risk", display = display.data_window)
tm_sl_minAtr   = input.float(0.5, "SL min (x ATR)",     minval = 0.1, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_sl_maxAtr   = input.float(3.0, "SL max (x ATR)",     minval = 0.5, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_rr1         = input.float(1.0, "TP1 (R)",            minval = 0.1, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_rr2         = input.float(2.0, "TP2 (R)",            minval = 0.1, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_rr3         = input.float(3.0, "TP3 (R)",            minval = 0.1, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_rrTarget    = input.string("TP2", "Mốc TP kiểm tra RR tối thiểu", options = ["TP1", "TP2", "TP3"], group = "TM · Risk", display = display.data_window)
tm_rrMin       = input.float(1.5, "RR toi thieu",       minval = 0.0, step = 0.1, group = "TM · Risk", display = display.data_window)
tm_maxDay      = input.int(3,     "Lenh toi da / ngay",  minval = 1, group = "TM · Risk", display = display.data_window)
tm_coolBars    = input.int(10,    "Cooldown (nen)",      minval = 0, group = "TM · Risk", display = display.data_window)
tm_maxHoldBars = input.int(300,   "Thoi gian giu toi da (nen timeout)", minval = 10, maxval = 2000, group = "TM · Risk", display = display.data_window)

// Futures Risk & Margin Model (Phase 4)
tm_risk_equity     = input.float(10000.0, "Von tai khoan (USDT)", minval = 100.0, step = 500.0, group = "TM · Futures Risk", display = display.data_window)
tm_risk_pct        = input.float(1.0,     "Rui ro moi lenh (% von)", minval = 0.1, maxval = 10.0, step = 0.1, group = "TM · Futures Risk", display = display.data_window)
tm_risk_maxLev     = input.float(20.0,    "Don bay toi da cho phep (x)", minval = 1.0, maxval = 125.0, step = 1.0, group = "TM · Futures Risk", display = display.data_window)
tm_risk_mmr        = input.float(0.005,   "Ty le ky quy duy tri MMR", minval = 0.001, maxval = 0.05, step = 0.001, group = "TM · Futures Risk", display = display.data_window)
tm_risk_feeSlipPct = input.float(0.10,    "Phi + Truot gia roundtrip (%)", minval = 0.0, maxval = 1.0, step = 0.01, group = "TM · Futures Risk", display = display.data_window)
tm_risk_checkLiq   = input.bool(true,     "Kiem tra SL truoc gia thanh ly", group = "TM · Futures Risk", display = display.data_window)
tm_risk_maxLosses  = input.int(3,         "Ngat mach khi thua lien tiep (lenh)", minval = 1, maxval = 10, group = "TM · Futures Risk", display = display.data_window)

