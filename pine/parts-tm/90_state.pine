// =============================================================================
//  L10 - STATE MACHINE (P0 Correctness Patch)
//  Position lifecycle: open -> manage (TP/SL/timeout) -> close -> deferred reset
//
//  P0 Fix:
//    - Timeout khong bi tinh nham thanh TP1; thoat tai gia close hien tai.
//    - Tinh realized R chinh xac cho moi loai thoat lenh.
//    - Thong ke phan biet ro: Wins (TP3), Losses (SL), Timeouts.
//    - Xu ly bao thu: nến cham ca SL va TP cung luc thi uu tien SL truoc.
// =============================================================================

int TM_EXIT_NONE    = 0
int TM_EXIT_SL      = 1
int TM_EXIT_TP1     = 2
int TM_EXIT_TP2     = 3
int TM_EXIT_TP3     = 4
int TM_EXIT_TIMEOUT = 5

var int   tm_posDir     = 0
var float tm_posEntry   = na
var float tm_posSl      = na
var float tm_posTp1     = na
var float tm_posTp2     = na
var float tm_posTp3     = na
var float tm_posRisk    = na
var int   tm_posBars    = 0
var int   tm_posStage   = 0
var int   tm_posBar     = na
var string tm_posSigId  = ""
var bool  tm_needReset  = false
var int   tm_exitReason = TM_EXIT_NONE

var int tm_statTrades   = 0
var int tm_statWins     = 0
var int tm_statLosses   = 0
var int tm_statTimeouts = 0

var float tm_xEntry = na
var float tm_xSl    = na
var int   tm_xDir   = 0
var int   tm_xBar   = na
var float tm_xExit  = na
var float tm_xR     = na

var bool tm_evEntry   = false
var int  tm_evTp      = 0
var bool tm_evSl      = false
var bool tm_evTimeout = false
var bool tm_evClose   = false

tm_evEntry   := false
tm_evTp      := 0
tm_evSl      := false
tm_evTimeout := false
tm_evClose   := false

// 1. Deferred reset
if tm_needReset
    tm_needReset  := false
    tm_posDir     := 0
    tm_posBars    := 0
    tm_posStage   := 0
    tm_posEntry   := na
    tm_posSl      := na
    tm_posTp1     := na
    tm_posTp2     := na
    tm_posTp3     := na
    tm_posRisk    := na
    tm_posBar     := na
    tm_exitReason := TM_EXIT_NONE

// 2. Manage open position
if tm_posDir != 0
    bool  isUp = tm_posDir == 1
    float t1   = tm_posStage < 1 ? tm_posTp1 : na
    float t2   = tm_posStage < 2 ? tm_posTp2 : na
    float t3   = tm_posStage < 3 ? tm_posTp3 : na

    bool hitSl = isUp ? low  <= tm_posSl : high >= tm_posSl
    bool hit1  = not na(t1) and (isUp ? high >= t1 : low <= t1)
    bool hit2  = not na(t2) and (isUp ? high >= t2 : low <= t2)
    bool hit3  = not na(t3) and (isUp ? high >= t3 : low <= t3)
    bool closed = false

    // Chinh sach bao thu: nến dong thoi cham ca SL va TP thi uu tien SL
    if hitSl and (hit1 or hit2 or hit3)
        closed        := true
        tm_evSl       := true
        tm_evClose    := true
        tm_exitReason := TM_EXIT_SL
        tm_statLosses += 1
    else if hitSl
        closed        := true
        tm_evSl       := true
        tm_evClose    := true
        tm_exitReason := TM_EXIT_SL
        tm_statLosses += 1
    else if hit3
        tm_evTp       := 3
        tm_posStage   := 3
        closed        := true
        tm_evClose    := true
        tm_exitReason := TM_EXIT_TP3
        tm_statWins   += 1
    else if hit2
        tm_evTp     := 2
        tm_posStage := 2
    else if hit1
        tm_evTp     := 1
        tm_posStage := 1

    // P0 Fix: Timeout sau maxHoldBars nến - dong theo gia thi truong hien tai
    if not closed and tm_posBars >= tm_maxHoldBars
        closed          := true
        tm_evClose      := true
        tm_evTimeout    := true
        tm_exitReason   := TM_EXIT_TIMEOUT
        tm_statTimeouts += 1

    if closed
        tm_statTrades += 1
        tm_xEntry     := tm_posEntry
        tm_xSl        := tm_posSl
        tm_xDir       := tm_posDir
        tm_xBar       := tm_posBar
        // P0 Fix: xExit ghi dung gia thoat thuc te
        tm_xExit      := tm_evSl ? tm_posSl : tm_evTp == 3 ? tm_posTp3 : tm_evTimeout ? close : (tm_posStage == 2 ? tm_posTp2 : tm_posStage == 1 ? tm_posTp1 : close)
        tm_xR         := not na(tm_posRisk) and tm_posRisk > 0.0 ? (tm_xExit - tm_posEntry) * float(tm_posDir) / tm_posRisk : na
        
        // Phase 4: Track consecutive losses for Circuit Breaker
        if tm_exitReason == TM_EXIT_SL
            tm_consecLosses += 1
        else if tm_exitReason == TM_EXIT_TP3
            tm_consecLosses := 0
        else if tm_exitReason == TM_EXIT_TIMEOUT
            if nz(tm_xR, 0.0) > 0.0
                tm_consecLosses := 0
            else
                tm_consecLosses += 1

        tm_needReset  := true

// 3. Open new position
if tm_okBar and tm_signal and tm_posDir == 0
    tm_posDir     := tm_plan.dir
    tm_posEntry   := tm_plan.entry
    tm_posSl      := tm_plan.sl
    tm_posTp1     := tm_plan.tp1
    tm_posTp2     := tm_plan.tp2
    tm_posTp3     := tm_plan.tp3
    tm_posRisk    := tm_plan.risk
    tm_posBars    := 0
    tm_posStage   := 0
    tm_posBar     := bar_index
    tm_posSigId   := "TM_" + syminfo.ticker + "_" + timeframe.period + "_" + str.tostring(time) + "_" + (tm_plan.dir == 1 ? "L" : "S")
    tm_evEntry    := true
    tm_dayCount   += 1
    tm_barsSince  := 0
    tm_exitReason := TM_EXIT_NONE

if tm_posDir != 0 and not tm_evEntry and not tm_needReset
    tm_posBars += 1
