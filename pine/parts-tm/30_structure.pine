// =============================================================================
//  L2 - MARKET STRUCTURE ENGINE
//  Swing -> HH/HL/LH/LL -> BOS -> CHoCH -> MSS -> Retest -> Failed Breakout
//           -> Trend continuation / Pullback
//  Structured events (UDT TMEvent): timestamp, timeframe, confirmation state, levels.
// =============================================================================

type TMEvent
    string kind      // BOS / CHoCH / MSS / RETEST / FAILBRK / CONT / PULL / SWEEP
    string dir       // bull / bear
    int    srcBar    // bar_index cua nguon
    int    srcTime   // timestamp UTC cua nguon
    string tf        // timeframe.period luc do
    bool   confirmed // barstate.isconfirmed luc event xay ra
    float  level     // gia quan trong

var array<TMEvent> tm_evtBuf = array.new<TMEvent>()

f_pushEvent(string kind, string dir, int srcBar, int srcTime, bool confirmed, float level) =>
    array.push(tm_evtBuf, TMEvent.new(kind, dir, srcBar, srcTime, timeframe.period, confirmed, level))
    if array.size(tm_evtBuf) > 50
        array.shift(tm_evtBuf)

// --- State --------------------------------------------------------------------
var float tm_lastHigh    = na
var float tm_prevHigh    = na
var float tm_lastLow     = na
var float tm_prevLow     = na
var int   tm_lastHighBar = na
var int   tm_lastLowBar  = na
var int   tm_trend       = 0    // 1=bull, -1=bear, 0=undefined

var bool tm_bosUp     = false
var bool tm_bosDown   = false
var bool tm_chochUp   = false
var bool tm_chochDown = false
var bool tm_mssUp     = false
var bool tm_mssDown   = false

var float tm_brkLevel = na
var int   tm_brkDir   = 0
var int   tm_brkBar   = na

tm_bosUp     := false
tm_bosDown   := false
tm_chochUp   := false
tm_chochDown := false
tm_mssUp     := false
tm_mssDown   := false

bool tm_okConfirmed = not tm_confirmOnly or barstate.isconfirmed

// --- Pivot processing ---------------------------------------------------------
if not na(tm_pivH)
    float tm_newH = high[tm_ms_swLen]
    int   tm_newHBar = bar_index - tm_ms_swLen
    if not na(tm_lastHigh)
        if tm_trend <= 0 and close > tm_lastHigh
            tm_bosUp   := true
            tm_trend   := 1
            tm_brkLevel := tm_lastHigh
            tm_brkDir  := 1
            tm_brkBar  := tm_newHBar
        if tm_trend < 0 and tm_newH > tm_lastHigh
            tm_chochUp := true
            tm_trend   := 1
            tm_brkLevel := tm_lastHigh
            tm_brkDir  := 1
            tm_brkBar  := tm_newHBar
        tm_prevHigh := tm_lastHigh
    tm_lastHigh    := tm_newH
    tm_lastHighBar := tm_newHBar

if not na(tm_pivL)
    float tm_newL = low[tm_ms_swLen]
    int   tm_newLBar = bar_index - tm_ms_swLen
    if not na(tm_lastLow)
        if tm_trend >= 0 and close < tm_lastLow
            tm_bosDown := true
            tm_trend   := -1
            tm_brkLevel := tm_lastLow
            tm_brkDir  := -1
            tm_brkBar  := tm_newLBar
        if tm_trend > 0 and tm_newL < tm_lastLow
            tm_chochDown := true
            tm_trend     := -1
            tm_brkLevel  := tm_lastLow
            tm_brkDir   := -1
            tm_brkBar   := tm_newLBar
        tm_prevLow := tm_lastLow
    tm_lastLow    := tm_newL
    tm_lastLowBar := tm_newLBar

// --- MSS: pha vung bang displacement candle -----------------------------------
if tm_bosUp and tm_dispBull
    tm_mssUp := true
if tm_bosDown and tm_dispBear
    tm_mssDown := true
if tm_chochUp and tm_dispBull
    tm_mssUp := true
if tm_chochDown and tm_dispBear
    tm_mssDown := true

// --- HH/HL/LH/LL classification ------------------------------------------------
tm_isHH = not na(tm_pivH) and not na(tm_prevHigh) and high[tm_ms_swLen] > tm_prevHigh
tm_isLH = not na(tm_pivH) and not na(tm_prevHigh) and high[tm_ms_swLen] < tm_prevHigh
tm_isHL = not na(tm_pivL) and not na(tm_prevLow)  and low[tm_ms_swLen]  > tm_prevLow
tm_isLL = not na(tm_pivL) and not na(tm_prevLow)  and low[tm_ms_swLen]  < tm_prevLow

// --- Retest -------------------------------------------------------------------
tm_retestBull = tm_ms_retestOn and tm_brkDir == 1 and not na(tm_brkLevel) and not na(tm_brkBar) and bar_index - tm_brkBar <= tm_ms_retestBars and low <= tm_brkLevel + tm_ms_retestTol * tm_atr and close > tm_brkLevel
tm_retestBear = tm_ms_retestOn and tm_brkDir == -1 and not na(tm_brkLevel) and not na(tm_brkBar) and bar_index - tm_brkBar <= tm_ms_retestBars and high >= tm_brkLevel - tm_ms_retestTol * tm_atr and close < tm_brkLevel

// --- Failed Breakout ----------------------------------------------------------
tm_failBull = tm_ms_failOn and tm_brkDir == -1 and not na(tm_brkLevel) and not na(tm_brkBar) and bar_index - tm_brkBar <= tm_ms_failBars and close > tm_brkLevel
tm_failBear = tm_ms_failOn and tm_brkDir == 1 and not na(tm_brkLevel) and not na(tm_brkBar) and bar_index - tm_brkBar <= tm_ms_failBars and close < tm_brkLevel

// --- Trend continuation / Pullback --------------------------------------------
tm_contBull = tm_ms_contOn and tm_trend == 1 and tm_isHH
tm_contBear = tm_ms_contOn and tm_trend == -1 and tm_isLL
tm_pullBull = tm_ms_pullOn and tm_trend == 1 and low <= tm_emaM and close > tm_emaM
tm_pullBear = tm_ms_pullOn and tm_trend == -1 and high >= tm_emaM and close < tm_emaM

// --- Structured events buffer (chi ghi khi nen da dong) -----------------------
if tm_okConfirmed and tm_bosUp
    f_pushEvent("BOS", "bull", tm_lastHighBar, time, barstate.isconfirmed, tm_lastHigh)
if tm_okConfirmed and tm_bosDown
    f_pushEvent("BOS", "bear", tm_lastLowBar, time, barstate.isconfirmed, tm_lastLow)
if tm_okConfirmed and tm_chochUp
    f_pushEvent("CHoCH", "bull", tm_lastHighBar, time, barstate.isconfirmed, tm_lastHigh)
if tm_okConfirmed and tm_chochDown
    f_pushEvent("CHoCH", "bear", tm_lastLowBar, time, barstate.isconfirmed, tm_lastLow)
if tm_okConfirmed and tm_mssUp
    f_pushEvent("MSS", "bull", tm_lastHighBar, time, barstate.isconfirmed, tm_lastHigh)
if tm_okConfirmed and tm_mssDown
    f_pushEvent("MSS", "bear", tm_lastLowBar, time, barstate.isconfirmed, tm_lastLow)
if tm_okConfirmed and tm_retestBull
    f_pushEvent("RETEST", "bull", bar_index, time, barstate.isconfirmed, tm_brkLevel)
if tm_okConfirmed and tm_retestBear
    f_pushEvent("RETEST", "bear", bar_index, time, barstate.isconfirmed, tm_brkLevel)
if tm_okConfirmed and tm_failBull
    f_pushEvent("FAILBRK", "bull", bar_index, time, barstate.isconfirmed, tm_brkLevel)
if tm_okConfirmed and tm_failBear
    f_pushEvent("FAILBRK", "bear", bar_index, time, barstate.isconfirmed, tm_brkLevel)
if tm_okConfirmed and tm_contBull
    f_pushEvent("CONT", "bull", tm_lastHighBar, time, barstate.isconfirmed, tm_lastHigh)
if tm_okConfirmed and tm_contBear
    f_pushEvent("CONT", "bear", tm_lastLowBar, time, barstate.isconfirmed, tm_lastLow)
if tm_okConfirmed and tm_pullBull
    f_pushEvent("PULL", "bull", bar_index, time, barstate.isconfirmed, tm_emaM)
if tm_okConfirmed and tm_pullBear
    f_pushEvent("PULL", "bear", bar_index, time, barstate.isconfirmed, tm_emaM)

// --- Labels (gate bang master switch) -----------------------------------------
if tm_showViz and tm_ms_bosOn and tm_bosUp
    label.new(bar_index, low,  "BOS+", style = label.style_label_up,   color = color.new(tm_cBull, 20), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_bosOn and tm_bosDown
    label.new(bar_index, high, "BOS-", style = label.style_label_down, color = color.new(tm_cBear, 20), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_chochOn and tm_chochUp
    label.new(bar_index, low,  "CHoCH+", style = label.style_label_up,   color = color.new(tm_cBull, 0), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_chochOn and tm_chochDown
    label.new(bar_index, high, "CHoCH-", style = label.style_label_down, color = color.new(tm_cBear, 0), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_mssOn and tm_mssUp and not tm_bosUp
    label.new(bar_index, low,  "MSS+", style = label.style_label_up,   color = color.new(#f5c542, 10), textcolor = color.black, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_mssOn and tm_mssDown and not tm_bosDown
    label.new(bar_index, high, "MSS-", style = label.style_label_down, color = color.new(#f5c542, 10), textcolor = color.black, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_retestOn and tm_retestBull
    label.new(bar_index, low, "RT+", style = label.style_label_up, color = color.new(tm_cBull, 40), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_retestOn and tm_retestBear
    label.new(bar_index, high, "RT-", style = label.style_label_down, color = color.new(tm_cBear, 40), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_failOn and tm_failBull
    label.new(bar_index, low, "FAIL+", style = label.style_label_up, color = color.new(color.gray, 10), textcolor = color.white, size = size.tiny, force_overlay = true)
if tm_showViz and tm_ms_failOn and tm_failBear
    label.new(bar_index, high, "FAIL-", style = label.style_label_down, color = color.new(color.gray, 10), textcolor = color.white, size = size.tiny, force_overlay = true)
