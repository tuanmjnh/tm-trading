// =============================================================================
//  L5 - CANDLE PATTERN ENGINE
//  Rejection, Displacement, Pin, Engulfing -> diem [-1.0, +1.0] (tm_cpScore)
// =============================================================================

float tm_prevBody = math.abs(close[1] - open[1])

// Pin Bar
bool tm_bullPin = tm_bullBar and tm_loWick >= tm_cp_pinRatio * tm_body
bool tm_bearPin = tm_bearBar and tm_hiWick >= tm_cp_pinRatio * tm_body

// Engulfing
bool tm_bullEng = tm_bullBar and close[1] < open[1] and close >= open[1] and open <= close[1] and tm_body >= tm_prevBody
bool tm_bearEng = tm_bearBar and close[1] > open[1] and close <= open[1] and open >= close[1] and tm_body >= tm_prevBody

// Displacement candle
bool tm_dispBullV = tm_dispBull and tm_bullBar and tm_vol >= tm_vol_spikeR * tm_volMA
bool tm_dispBearV = tm_dispBear and tm_bearBar and tm_vol >= tm_vol_spikeR * tm_volMA

// Rejection candle
bool tm_bullRej = tm_hiWick >= tm_range * 0.55 and tm_loWick <= tm_range * 0.15 and tm_bullBar
bool tm_bearRej = tm_loWick >= tm_range * 0.55 and tm_hiWick <= tm_range * 0.15 and tm_bearBar

float tm_cpBull = 0.0
float tm_cpBear = 0.0
if tm_cp_pin
    tm_cpBull += tm_bullPin ? 1.0 : 0.0
    tm_cpBear += tm_bearPin ? 1.0 : 0.0
if tm_cp_engulf
    tm_cpBull += tm_bullEng ? 1.0 : 0.0
    tm_cpBear += tm_bearEng ? 1.0 : 0.0
if tm_cp_disp
    tm_cpBull += tm_dispBullV ? 1.2 : 0.0
    tm_cpBear += tm_dispBearV ? 1.2 : 0.0
if tm_cp_rej
    tm_cpBull += tm_bullRej ? 0.8 : 0.0
    tm_cpBear += tm_bearRej ? 0.8 : 0.0

float tm_cpScore = tm_cpBull > tm_cpBear ? math.min(1.0, tm_cpBull / 3.0) : tm_cpBear > tm_cpBull ? -math.min(1.0, tm_cpBear / 3.0) : 0.0
