// =============================================================================
//  L1 - CORE UTILITIES (ATR/ATR%, Volume VSA, RelVol, OBV, EMA, pivots, session)
// =============================================================================

// f_clamp / f_fmtPx / f_isNewDay - shared (pine/shared/common.pine)
// --- Volatility ---------------------------------------------------------------
tm_atr    = ta.atr(tm_atrLen)
tm_atrPct = tm_atr / close * 100.0

// --- Volume engine (VSA buckets, RelVol, TIM) ---------------------------------
tm_vol   = nz(volume)
tm_volMA = ta.rma(tm_vol, tm_vol_maLen)
tm_volSessOk = not tm_vol_sessOn or f_sessionOk(tm_vol_sess, tm_vol_tz)
tm_volEvtOk  = (tm_vol_min <= 0.0 or tm_vol >= tm_vol_min) and tm_volSessOk
tm_volRatio  = not na(tm_volMA) and tm_volMA > 0.0 ? tm_vol / tm_volMA : 0.0
tm_volBucket = f_vsaName(tm_vol, tm_volMA, tm_vol_spikeR, tm_vol_rVH, tm_vol_rH, tm_vol_rN, tm_vol_rL)
tm_isTimRaw  = not na(tm_volMA) and tm_volMA > 0.0 and tm_vol >= tm_volMA * tm_vol_spikeR
tm_isTim     = tm_isTimRaw and tm_volEvtOk
tm_timCount  = math.sum(tm_isTim ? 1.0 : 0.0, tm_vol_purWin)

// RelVolume (volume hien tai / TB volume cua so)
tm_volSma20 = ta.sma(tm_vol, tm_rvLen)
tm_relVol   = not na(tm_volSma20) and tm_volSma20 > 0.0 ? tm_vol / tm_volSma20 : 0.0

// OBV (On-Balance Volume)
var float tm_obv = 0.0
tm_obv := tm_obv + (close > close[1] ? tm_vol : close < close[1] ? -tm_vol : 0.0)
var array<float> tm_obvHist    = array.new<float>()
var int          tm_obvHistBar = -1
if tm_obvHistBar != bar_index
    array.push(tm_obvHist, tm_obv)
    tm_obvHistBar := bar_index
while array.size(tm_obvHist) > tm_obvLen + 2
    array.shift(tm_obvHist)
int   tm_obvLag  = array.size(tm_obvHist) - 1 - tm_obvLen
float tm_obvPrev = na
if tm_obvLag >= 0
    tm_obvPrev := array.get(tm_obvHist, tm_obvLag)
tm_obvSlope = tm_obv - nz(tm_obvPrev)

// --- Trend stack (EMA 20/50/200) -----------------------------------------------
tm_emaF = ta.ema(close, tm_emaFast)
tm_emaM = ta.ema(close, tm_emaMid)
tm_emaS = ta.ema(close, tm_emaSlow)
tm_emaStackBull = tm_emaF > tm_emaM and tm_emaM > tm_emaS
tm_emaStackBear = tm_emaF < tm_emaM and tm_emaM < tm_emaS

// --- Candle metrics ------------------------------------------------------------
tm_body    = math.abs(close - open)
tm_range   = math.max(high - low, syminfo.mintick)
tm_hiWick  = high - math.max(close, open)
tm_loWick  = math.min(close, open) - low
tm_bullBar = close > open
tm_bearBar = close < open
tm_dispBull = tm_body >= tm_cp_dispAtr * tm_atr and tm_hiWick < tm_body * 0.3
tm_dispBear = tm_body >= tm_cp_dispAtr * tm_atr and tm_loWick < tm_body * 0.3

// --- Pivots / swing extremes ---------------------------------------------------
tm_pivH = ta.pivothigh(high, tm_ms_swLen, tm_ms_swLen)
tm_pivL = ta.pivotlow(low,   tm_ms_swLen, tm_ms_swLen)
tm_swingLo = ta.lowest(low,  tm_sl_swing)
tm_swingHi = ta.highest(high, tm_sl_swing)

// --- Asset Profile Detection (Phase 2) ----------------------------------------
f_detectAsset(string sym) =>
    string s = str.upper(sym)
    str.contains(s, "XAU") or str.contains(s, "GOLD") ? "XAU" : str.contains(s, "BTC") ? "BTC" : str.contains(s, "ETH") ? "ETH" : "Custom"

string tm_activeProfile = tm_assetMode == "Auto" ? f_detectAsset(syminfo.ticker) : tm_assetMode
bool   tm_isCrypto      = tm_activeProfile == "BTC" or tm_activeProfile == "ETH" or tm_activeProfile == "Liquid Altcoin" or tm_activeProfile == "High-Risk Altcoin"

// --- Session engine (Asia / London / NY / Overlap) -----------------------------
tm_sessAsia     = f_sessAsia(tm_sessTz)
tm_sessLondon   = f_sessLondon(tm_sessTz)
tm_sessNy       = f_sessNy(tm_sessTz)
tm_sessOverlap  = tm_sessLondon and tm_sessNy
float tm_sessScoreRaw = tm_sessOverlap ? 1.0 : tm_sessNy ? 0.8 : tm_sessLondon ? 0.6 : tm_sessAsia ? 0.2 : 0.0
// Crypto 24/7 Session Policy: Neu la Crypto va bat session neutral thi score = 1.0 (khong phat gio)
float tm_sessScore    = (tm_isCrypto and tm_cryptoSessionNeutral) ? 1.0 : tm_sessScoreRaw
