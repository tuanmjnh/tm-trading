// =============================================================================
//  L6 - TECHNICAL INDICATOR ENGINE
//  Nhom theo chuc nang: Trend / Momentum / Volatility / Volume / Location
//  Chi so correlated duoc average ben trong nhom de tranh tinh trung lap.
// =============================================================================

// --- Momentum: RSI + MACD + DMI/ADX --------------------------------------------
float tm_rsi = ta.rsi(close, tm_rsiLen)
float tm_rsiScore = tm_rsi < tm_rsiOs ? 1.0 : tm_rsi > tm_rsiOb ? -1.0 : 0.0

[ tm_macdLine, tm_macdSig, tm_macdHist ] = ta.macd(close, tm_macdF, tm_macdS, tm_macdSigLen)
float tm_macdScore = ta.crossover(tm_macdLine, tm_macdSig) ? 1.0 : ta.crossunder(tm_macdLine, tm_macdSig) ? -1.0 : tm_macdHist > 0 ? 0.5 : tm_macdHist < 0 ? -0.5 : 0.0

[ tm_diPlus, tm_diMinus, tm_adx ] = ta.dmi(tm_dmiLen, tm_dmiSmooth)
float tm_dmiScore = tm_adx >= tm_adxMin ? (tm_diPlus > tm_diMinus ? 1.0 : -1.0) : 0.0

float tm_momScore = (tm_rsiScore + tm_macdScore + tm_dmiScore) / 3.0

// --- Volatility: ATR regime + Bollinger Band Width -----------------------------
float tm_atrMa = ta.sma(tm_atr, 20)
float tm_atrRegime = tm_atr > tm_atrMa * 1.2 ? 1.0 : tm_atr < tm_atrMa * 0.8 ? 0.0 : 0.5
[ tm_bbMid, tm_bbUp, tm_bbLo ] = ta.bb(close, tm_bbLen, tm_bbMult)
float tm_bbWidth = (tm_bbUp - tm_bbLo) / tm_bbMid * 100.0
float tm_bbWidthMa = ta.sma(tm_bbWidth, tm_bbLen)
bool  tm_bbExpand = tm_bbWidth > tm_bbWidthMa
float tm_volScore = tm_bbExpand ? (close > open ? 0.5 : -0.5) : 0.0

// --- Volume: RelVol + OBV slope + VSA bucket -----------------------------------
float tm_relVolScore = tm_relVol >= tm_rvMin ? (close > open ? 1.0 : close < open ? -1.0 : 0.0) : 0.0
float tm_obvScore = tm_obvSlope > 0 ? 1.0 : tm_obvSlope < 0 ? -1.0 : 0.0
float tm_vsaScore = tm_isTim ? (tm_bullBar ? 1.0 : tm_bearBar ? -1.0 : 0.0) : 0.0
float tm_volumeScore = (tm_relVolScore + tm_obvScore + tm_vsaScore) / 3.0

// --- Location: VWAP + daily range ----------------------------------------------
float tm_vwap = ta.vwap(close)
bool  tm_vwapOk = not na(tm_vwap)
float tm_vwapScore = tm_vwapOk ? (close > tm_vwap ? 1.0 : close < tm_vwap ? -1.0 : 0.0) : 0.0
float tm_dayRange = not na(tm_pdh) and not na(tm_pdl) and tm_pdh > tm_pdl ? (close - tm_pdl) / (tm_pdh - tm_pdl) * 2.0 - 1.0 : 0.0
float tm_locationScore = (tm_vwapScore + f_clamp(tm_dayRange, -1.0, 1.0)) / 2.0

// --- Trend: EMA stack ----------------------------------------------------------
float tm_trendScore = tm_emaStackBull ? 1.0 : tm_emaStackBear ? -1.0 : (close > tm_emaF and tm_emaF > tm_emaM ? 0.5 : close < tm_emaF and tm_emaF < tm_emaM ? -0.5 : 0.0)
