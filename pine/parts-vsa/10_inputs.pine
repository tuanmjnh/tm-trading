// =============================================================================
//  LAYER 1 - INPUTS : tat ca thong so nguoi dung (group "TM · ...")
//  Dieu chinh chinh: TIM = cot volume dot bien (ratio >= tm_i_rP) - tin hieu chinh.
// =============================================================================

tm_confirmOnly = input.bool(true, "Chi tin khi nen dong", group = "TM · Chung", display = display.data_window)

// -----------------------------------------------------------------------------
//  Volume - 6 bucket theo ratio so voi MA Wilder, TIM luon la bucket cao nhat
// -----------------------------------------------------------------------------
tm_i_len     = input.int(20, "Cua so Volume MA (Wilder RMA)", minval = 5, maxval = 100, group = "TM · Volume", display = display.data_window)
tm_i_showMA  = input.bool(true, "Hien Volume MA", group = "TM · Volume", display = display.data_window)
tm_i_rP      = input.float(2.2, "TIM - cot dot bien (ratio)", minval = 1.5, step = 0.1, group = "TM · Volume", display = display.data_window)
tm_i_rVH     = input.float(1.8, "VeryHigh (ratio)", minval = 1.0, step = 0.1, group = "TM · Volume", display = display.data_window)
tm_i_rH      = input.float(1.2, "High (ratio)", minval = 0.8, step = 0.1, group = "TM · Volume", display = display.data_window)
tm_i_rN      = input.float(0.8, "Normal (ratio)", minval = 0.4, step = 0.1, group = "TM · Volume", display = display.data_window)
tm_i_rL      = input.float(0.4, "Low (ratio)", minval = 0.1, step = 0.1, group = "TM · Volume", display = display.data_window)
tm_i_purWin  = input.int(20, "Cua so dem cot TIM (dashboard)", minval = 5, maxval = 100, group = "TM · Volume", display = display.data_window)
tm_i_volMin  = input.float(0.0, "Volume toi thieu tuyet doi (0 = tat, cho alt coin thap)", minval = 0.0, group = "TM · Volume", display = display.data_window)
// tm_i_sessOn / tm_i_sess / tm_i_tz / tm_i_sessTz - shared (pine/shared/sess-inputs.pine)

// -----------------------------------------------------------------------------
//  Su kien - SV/BC phai qua cong cot TIM; ST/NS/ND la xac nhan (nhac nho)
// -----------------------------------------------------------------------------
tm_i_evtOn    = input.bool(true, "Bat su kien VSA (SV/BC/ST)", group = "TM · Su kien", display = display.data_window)
tm_i_quietOn  = input.bool(true, "Bat NS/ND (cot am)", group = "TM · Su kien", display = display.data_window)
tm_i_run      = input.int(5, "So nen tinh momentum (muc chay)", minval = 1, maxval = 50, group = "TM · Su kien", display = display.data_window)
tm_i_lvTol    = input.float(0.5, "Do rong vung H/T (x ATR)", minval = 0.1, step = 0.1, group = "TM · Su kien", display = display.data_window)
tm_i_lvFresh  = input.int(60, "H/T con hieu luc (so nen)", minval = 10, maxval = 500, group = "TM · Su kien", display = display.data_window)
tm_i_testR    = input.float(1.2, "Nhip test - ratio nho hon gia tri nay", minval = 0.3, maxval = 2.0, step = 0.1, group = "TM · Su kien", display = display.data_window)
tm_i_retestT  = input.float(1.0, "Ban kinh test lai (x ATR)", minval = 0.2, step = 0.1, group = "TM · Su kien", display = display.data_window)
tm_i_atrLen   = input.int(14, "ATR", minval = 2, maxval = 100, group = "TM · Su kien", display = display.data_window)
tm_i_pivLen   = input.int(20, "Do dai pivot (H/T)", minval = 5, maxval = 100, group = "TM · Su kien", display = display.data_window)

// -----------------------------------------------------------------------------
//  Hien thi
// -----------------------------------------------------------------------------
tm_i_showViz   = input.bool(true, "Tat toan bo hien thi (master)", group = "TM · Hien thi", display = display.data_window)
tm_i_showSig   = input.bool(true, "Nhan su kien VSA (SV/BC/ST/NS/ND)", group = "TM · Hien thi", display = display.data_window)
tm_i_showVol   = input.bool(true, "Histogram Volume", group = "TM · Hien thi", display = display.data_window)
tm_i_dash      = input.bool(true, "Dashboard", group = "TM · Hien thi", display = display.data_window)
tm_i_dashSize  = input.string("Small", "Size dashboard", options = ["Tiny", "Small", "Normal"], group = "TM · Hien thi", display = display.data_window)
tm_i_pivOn     = input.bool(true, "Ve duong H/T (cham)", group = "TM · Hien thi", display = display.data_window)
tm_i_lvlOn     = input.bool(true, "Ve Entry/SL/TP (setup ST gan nhat)", group = "TM · Hien thi", display = display.data_window)
tm_i_slBuf     = input.float(0.5, "SL buffer (x ATR)", minval = 0.1, step = 0.1, group = "TM · Hien thi", display = display.data_window)
tm_i_rrFb      = input.float(2.0, "TP fallback (R) - chi dung khi khong co pivot doi dien", minval = 0.5, step = 0.5, group = "TM · Hien thi", display = display.data_window)

// -----------------------------------------------------------------------------
//  Phi & rui ro - rang buoc TOAN HOC, khong phai so thich (docs/vsa-optimization.md)
//  Phi round-trip 0.1% quy ra R = phi / (slBuf x ATR%). Voi slBuf = 0.5 tren khung
//  5m (ATR ~ 0.14% gia), rieng phi da bang 1.40R -> moi lenh vao da am 1.4R truoc
//  khi gia kip di. Vi vay stop PHAI du rong de phi khong an het loi the.
// -----------------------------------------------------------------------------
tm_i_feePct    = input.float(0.05, "Phi moi chieu - taker (%)", minval = 0.0, step = 0.01, group = "TM · Phi & Rui ro", display = display.data_window)
tm_i_feeMaxR   = input.float(0.15, "Canh bao khi phi/R vuot", minval = 0.01, step = 0.05, group = "TM · Phi & Rui ro", display = display.data_window)

// -----------------------------------------------------------------------------
//  Kieu vao lenh / kieu dat TP (docs/vsa-optimization.md §5b)
//  Market: vao tai CLOSE bar ST (bar xac nhan) -> moi tin hieu deu thanh lenh.
//  Limit : limit tai cuc tri SV/BC (hanh vi cu) -> da do: 64-72% setup KHONG BAO GIO
//          khop trong cua so cua no, va so it khop duoc thi khop vi gia dang dam
//          xuyen qua muc do -> gan nhu chac chan SL.
//  TP 'Theo R': R co dinh -> SO SANH DUOC giua cac lenh.
//  TP 'Pivot' : hanh vi cu; R moi lenh khac nhau nen vai lenh thang lon chi phoi.
// -----------------------------------------------------------------------------
tm_i_entryMode = input.string("Market (xac nhan ST)", "Kieu vao lenh", options = ["Market (xac nhan ST)", "Limit (cuc tri SV/BC)"], group = "TM · Vao lenh", display = display.data_window)
tm_i_tpMode    = input.string("Theo R (co dinh)", "Kieu dat TP", options = ["Theo R (co dinh)", "Pivot doi dien"], group = "TM · Vao lenh", display = display.data_window)
tm_entryMarket = tm_i_entryMode == "Market (xac nhan ST)"
tm_tpTheoR     = tm_i_tpMode == "Theo R (co dinh)"

// -----------------------------------------------------------------------------
//  CHIEN LUOC (docs/vsa-optimization.md §5c muc 1)
//  'VSA dao chieu'      : VSA PHAT tin hieu - SV/BC -> ST -> vao lenh.
//  'VSA loc + Wyckoff'  : VSA chi lam BO LOC xac dinh VUNG (SV = vung cau,
//      BC = vung cung); THOI DIEM vao lenh do SU KIEN WYCKOFF quyet dinh.
//      Truong phai: BOS/CHoCH la ky thuat SMC, khong phai Wyckoff - nen dung
//      spring/UTAD (Phase C) va SOS/SOW (Phase D).
// -----------------------------------------------------------------------------
tm_i_signalMode   = input.string("VSA dao chieu", "Chien luoc", options = ["VSA dao chieu", "VSA loc + Wyckoff"], group = "TM · Chien luoc", display = display.data_window)
tm_i_wyckoffEvent = input.string("LPS", "Su kien Wyckoff", options = ["Spring", "SOS", "LPS"], group = "TM · Chien luoc", display = display.data_window)
tm_i_sosSpread    = input.float(1.0, "SOS/SOW: than nen (x ATR)", minval = 0.2, step = 0.1, group = "TM · Chien luoc", display = display.data_window)
tm_i_sosVol       = input.float(1.2, "SOS/SOW: volume (x MA)", minval = 0.5, step = 0.1, group = "TM · Chien luoc", display = display.data_window)
tm_i_lpsTol       = input.float(0.5, "LPS/LPSY: sai so vung (x ATR)", minval = 0.1, step = 0.1, group = "TM · Chien luoc", display = display.data_window)
tm_wyckoffMode    = tm_i_signalMode == "VSA loc + Wyckoff"
