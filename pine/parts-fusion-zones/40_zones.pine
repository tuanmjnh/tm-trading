// =============================================================================
//  40_ZONES — Dynamic Supply & Demand Zones, Touch Tracking & Mitigation
// =============================================================================

// --- 1. Zone Data Structure --------------------------------------------------
type FzZone
    float top
    float bot
    int   side       // 1 = Demand (Support), -1 = Supply (Resistance)
    int   touches
    bool  broken
    int   startBar

var array<FzZone> fz_zones = array.new<FzZone>()

// --- 2. Pivot Detection for Zone Creation ------------------------------------
// ta.pivothigh/ta.pivotlow are evaluated at root scope
float fz_zn_ph = ta.pivothigh(high, fz_zn_swLen, fz_zn_swLen)
float fz_zn_pl = ta.pivotlow(low, fz_zn_swLen, fz_zn_swLen)

// --- 3. Zone Management Engine -----------------------------------------------
float fz_zoneHalfWidth = fz_atrSafe * fz_zn_widthAtr * 0.5

// Register Supply Zone from confirmed Pivot High
if not na(fz_zn_ph)
    float pHigh = fz_zn_ph
    bool merged = false
    if array.size(fz_zones) > 0
        for i = 0 to array.size(fz_zones) - 1
            FzZone z = array.get(fz_zones, i)
            if not z.broken and z.side == -1
                float mid = (z.top + z.bot) * 0.5
                if math.abs(mid - pHigh) <= (fz_atrSafe * fz_zn_widthAtr)
                    z.top     := math.max(z.top, pHigh + fz_zoneHalfWidth)
                    z.bot     := math.min(z.bot, pHigh - fz_zoneHalfWidth)
                    z.touches += 1
                    merged    := true
                    break
    if not merged
        array.push(fz_zones, FzZone.new(pHigh + fz_zoneHalfWidth, pHigh - fz_zoneHalfWidth, -1, 1, false, bar_index - fz_zn_swLen))

// Register Demand Zone from confirmed Pivot Low
if not na(fz_zn_pl)
    float pLow = fz_zn_pl
    bool merged = false
    if array.size(fz_zones) > 0
        for i = 0 to array.size(fz_zones) - 1
            FzZone z = array.get(fz_zones, i)
            if not z.broken and z.side == 1
                float mid = (z.top + z.bot) * 0.5
                if math.abs(mid - pLow) <= (fz_atrSafe * fz_zn_widthAtr)
                    z.top     := math.max(z.top, pLow + fz_zoneHalfWidth)
                    z.bot     := math.min(z.bot, pLow - fz_zoneHalfWidth)
                    z.touches += 1
                    merged    := true
                    break
    if not merged
        array.push(fz_zones, FzZone.new(pLow + fz_zoneHalfWidth, pLow - fz_zoneHalfWidth, 1, 1, false, bar_index - fz_zn_swLen))

// Check Touches and Break / Mitigation on every bar
if array.size(fz_zones) > 0
    for i = 0 to array.size(fz_zones) - 1
        FzZone z = array.get(fz_zones, i)
        if not z.broken
            if z.side == 1 // Demand
                if close < z.bot
                    z.broken := true
                else if low <= z.top and high >= z.bot
                    // Price touched or is inside zone
                    if low[1] > z.top
                        z.touches += 1
            else // Supply
                if close > z.top
                    z.broken := true
                else if high >= z.bot and low <= z.top
                    // Price touched or is inside zone
                    if high[1] < z.bot
                        z.touches += 1

// Clean up broken zones and enforce max quota
if array.size(fz_zones) > 0
    for i = array.size(fz_zones) - 1 to 0
        FzZone z = array.get(fz_zones, i)
        if z.broken
            array.remove(fz_zones, i)

while array.size(fz_zones) > fz_zn_max
    array.shift(fz_zones)

// --- 4. Current Bar Zone Interactions ----------------------------------------
bool  fz_inDemandZone  = false
bool  fz_inSupplyZone  = false
float fz_demandZoneBot = na
float fz_demandZoneTop = na
float fz_supplyZoneTop = na
float fz_supplyZoneBot = na

if array.size(fz_zones) > 0
    for i = 0 to array.size(fz_zones) - 1
        FzZone z = array.get(fz_zones, i)
        if not z.broken
            if z.side == 1
                if low <= z.top + (fz_atrSafe * 0.2) and high >= z.bot - (fz_atrSafe * 0.2)
                    fz_inDemandZone  := true
                    fz_demandZoneBot := z.bot
                    fz_demandZoneTop := z.top
            else if z.side == -1
                if high >= z.bot - (fz_atrSafe * 0.2) and low <= z.top + (fz_atrSafe * 0.2)
                    fz_inSupplyZone  := true
                    fz_supplyZoneTop := z.top
                    fz_supplyZoneBot := z.bot

// --- 5. Obstacle Gate Helper: Find Nearest Opposing Zone ----------------------
f_nearestOpposingZoneDistance(bool isLong, float curPx) =>
    float nearestDist = 1e9
    if array.size(fz_zones) > 0
        for i = 0 to array.size(fz_zones) - 1
            FzZone z = array.get(fz_zones, i)
            if not z.broken
                if isLong and z.side == -1 and z.bot > curPx
                    float dist = z.bot - curPx
                    if dist < nearestDist
                        nearestDist := dist
                else if not isLong and z.side == 1 and z.top < curPx
                    float dist = curPx - z.top
                    if dist < nearestDist
                        nearestDist := dist
    nearestDist < 1e8 ? nearestDist : 1e9

f_nearestOpposingZoneLevel(bool isLong, float curPx) =>
    float nearestDist = 1e9
    float targetLevel = na
    if array.size(fz_zones) > 0
        for i = 0 to array.size(fz_zones) - 1
            FzZone z = array.get(fz_zones, i)
            if not z.broken
                if isLong and z.side == -1 and z.bot > curPx
                    float dist = z.bot - curPx
                    if dist < nearestDist
                        nearestDist := dist
                        targetLevel := z.bot
                else if not isLong and z.side == 1 and z.top < curPx
                    float dist = curPx - z.top
                    if dist < nearestDist
                        nearestDist := dist
                        targetLevel := z.top
    targetLevel
