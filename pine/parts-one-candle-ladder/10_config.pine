// =============================================================================
//  L0 - CONFIG  (6 nhom input; moi quyet dinh cua phuong phap deu chinh duoc)
// =============================================================================

// --- Nhom 1: Chung ------------------------------------------------------------
ocl_confirmOnly = input.bool(true, "Chi tin hieu nen da dong (no-repaint)", group = "OCL · Chung", display = display.data_window)
ocl_payloadMode = input.string("Full", "Webhook payload", options = ["Full", "Slim", "Off"], group = "OCL · Chung", display = display.data_window)

// --- Nhom 2: Thang khung T1..T6 (di TU LON xuong NHO) -------------------------
ocl_tf1 = input.timeframe("D",   "T1 Boi canh (bias)",      group = "OCL · Thang khung", display = display.data_window)
ocl_tf2 = input.timeframe("240", "T2 Vung (cum nen)",       group = "OCL · Thang khung", display = display.data_window)
ocl_tf3 = input.timeframe("60",  "T3 Cau truc",             group = "OCL · Thang khung", display = display.data_window)
ocl_tf4 = input.timeframe("30",  "T4 Muc vao (LMT)",        group = "OCL · Thang khung", display = display.data_window)
ocl_tf5 = input.timeframe("15",  "T5 Nen tham chieu",       group = "OCL · Thang khung", display = display.data_window)
ocl_tf6 = input.timeframe("5",   "T6 Quan ly / nhoi",       group = "OCL · Thang khung", display = display.data_window)
ocl_enforceLadder = input.bool(true, "Bat buoc T1/T3 dong thuan moi cho tin hieu", group = "OCL · Thang khung", display = display.data_window)

// --- Nhom 3: Vung & pivot -----------------------------------------------------
ocl_pivotLen     = input.int(8,    "Pivot lookback (nen HTF)", minval = 2, maxval = 40, group = "OCL · Vung", display = display.data_window)
ocl_zoneBandATR  = input.float(0.35, "Band vung (x ATR H4)", minval = 0.05, maxval = 3.0, step = 0.05, group = "OCL · Vung", display = display.data_window)
ocl_clusterBars  = input.int(4,    "Cum nen toi thieu (chi de hien thi)", minval = 2, maxval = 10, group = "OCL · Vung", display = display.data_window)
ocl_showZone     = input.bool(true, "Hien thi vung T2", group = "OCL · Vung", display = display.data_window)

// --- Nhom 4: Nen tham chieu (T5) ---------------------------------------------
ocl_refMinScore   = input.int(2,     "So dieu kien toi thieu (0..4)", minval = 1, maxval = 4, group = "OCL · Nen tham chieu", display = display.data_window)
ocl_bodyMaxPct    = input.float(0.35, "[1] Than <= x bien do", minval = 0.05, maxval = 1.0, step = 0.05, group = "OCL · Nen tham chieu", display = display.data_window)
ocl_insideBarOn   = input.bool(true,  "[2] Inside bar (nam trong nen truoc)", group = "OCL · Nen tham chieu", display = display.data_window)
ocl_wickMinPct    = input.float(0.50, "[3] Rau tu choi >= x bien do", minval = 0.1, maxval = 1.0, step = 0.05, group = "OCL · Nen tham chieu", display = display.data_window)
ocl_rangeMaxATR   = input.float(0.60, "[4] Bien do <= x ATR", minval = 0.1, maxval = 3.0, step = 0.05, group = "OCL · Nen tham chieu", display = display.data_window)
ocl_requireAtZone = input.bool(true,  "Chi nhan nen nam trong vung T2/T3", group = "OCL · Nen tham chieu", display = display.data_window)
ocl_refMaxBars    = input.int(30,     "Setup het hieu luc sau (nen chart)", minval = 3, maxval = 200, group = "OCL · Nen tham chieu", display = display.data_window)
ocl_showRef       = input.bool(true,  "Ve cay nen tham chieu", group = "OCL · Nen tham chieu", display = display.data_window)

// --- Nhom 5: Entry / SL / TP --------------------------------------------------
ocl_entryMode    = input.string("ZoneLimit", "Kieu vao lenh", options = ["ZoneLimit", "CandleBreak"], group = "OCL · Entry & Risk", display = display.data_window)
ocl_entryBufferATR = input.float(0.05, "Dem vao lenh (x ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = "OCL · Entry & Risk", display = display.data_window)
ocl_slBufferATR  = input.float(0.20, "Dem sau nen cho SL (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = "OCL · Entry & Risk", display = display.data_window)
ocl_minRR        = input.float(2.5,  "RR toi thieu (bo qua neu duoi)", minval = 0.5, maxval = 10.0, step = 0.1, group = "OCL · Entry & Risk", display = display.data_window)
ocl_tp1Mode      = input.string("Pivot", "Cach lay TP1", options = ["Pivot", "R2"], group = "OCL · Entry & Risk", display = display.data_window)
ocl_partialAtR   = input.float(2.0,  "Chot mot phan tai (x R)", minval = 0.5, maxval = 6.0, step = 0.5, group = "OCL · Entry & Risk", display = display.data_window)
ocl_beAtR        = input.float(0.5,  "Doi SL ve hoa von tai (x R)", minval = 0.1, maxval = 3.0, step = 0.1, group = "OCL · Entry & Risk", display = display.data_window)

// --- Nhom 6: Nhoi lenh (MAC DINH TAT) ----------------------------------------
ocl_pyramidOn        = input.bool(false, "Bat nhoi lenh (mac dinh TAT)", group = "OCL · Nhoi lenh", display = display.data_window)
ocl_pyramidMaxMult   = input.float(4.0, "Tong khoi luong toi da (x L0)", minval = 1.0, maxval = 10.0, step = 0.5, group = "OCL · Nhoi lenh", display = display.data_window)
ocl_pyramidStepR     = input.float(0.5, "Buoc nhoi (x R)", minval = 0.1, maxval = 3.0, step = 0.1, group = "OCL · Nhoi lenh", display = display.data_window)
ocl_pyramidResetOnBE = input.bool(true, "Thoi nhoi sau khi SL ve hoa von", group = "OCL · Nhoi lenh", display = display.data_window)

// --- Nhom 7: Bo loc -----------------------------------------------------------
ocl_regimeOn    = input.bool(true,  "Loc theo ADX (bo qua thi truong di ngang)", group = "OCL · Bo loc", display = display.data_window)
ocl_adxLen      = input.int(14,     "ADX length", minval = 2, maxval = 50, group = "OCL · Bo loc", display = display.data_window)
ocl_adxSmooth   = input.int(14,     "ADX smoothing", minval = 2, maxval = 50, group = "OCL · Bo loc", display = display.data_window)
ocl_adxMin      = input.float(18.0, "ADX toi thieu de vao lenh", minval = 5.0, maxval = 50.0, step = 1.0, group = "OCL · Bo loc", display = display.data_window)
ocl_adxTrend    = input.float(25.0, "ADX tu muc nay = TRENDING", minval = 10.0, maxval = 50.0, step = 1.0, group = "OCL · Bo loc", display = display.data_window)
ocl_sessionOn   = input.bool(false, "Loc phien giao dich", group = "OCL · Bo loc", display = display.data_window)
ocl_session     = input.string("0700-2000", "Khung gio (gio server cua phien)", group = "OCL · Bo loc", display = display.data_window)
ocl_tz          = input.string("UTC", "Timezone phien", group = "OCL · Bo loc", display = display.data_window)
ocl_vsaOn       = input.bool(false, "Veto nen pha co volume yeu (VSA)", group = "OCL · Bo loc", display = display.data_window)
ocl_vsaMinRatio = input.float(0.8,  "Volume bucket toi thieu", minval = 0.1, maxval = 3.0, step = 0.1, group = "OCL · Bo loc", display = display.data_window)
ocl_feeR        = input.float(0.05, "Phi uoc tinh (x R, chi de hien thi)", minval = 0.0, maxval = 1.0, step = 0.01, group = "OCL · Bo loc", display = display.data_window)

// --- Nhom 8: Hien thi ---------------------------------------------------------
ocl_showViz  = input.bool(true,  "Bat hien thi", group = "OCL · Hien thi", display = display.data_window)
ocl_showDash = input.bool(true,  "Dashboard", group = "OCL · Hien thi", display = display.data_window)
ocl_showLevels = input.bool(true, "Ve Entry / SL / TP", group = "OCL · Hien thi", display = display.data_window)
ocl_cBull    = input.color(#089981, "Mau tang", group = "OCL · Hien thi", display = display.data_window)
ocl_cBear    = input.color(#f23645, "Mau giam", group = "OCL · Hien thi", display = display.data_window)
ocl_font     = input.string("tiny", "Co chu dashboard", options = ["tiny", "small", "normal"], group = "OCL · Hien thi", display = display.data_window)
