// =============================================================================
//  LAYER 4 - EVENTS
//  CHINH : SV (dung lai) / BC (muc dot bien) - ca 2 bat buoc qua cot TIM.
//  XAC NHAN : ST (test lai volume thap), NS/ND (cot am) - canh bao nhac nho.
//  Thu tu uu tien khi cung bar: SV > BC > ST > NS > ND.
// =============================================================================
tm_sigSV = tm_i_evtOn and tm_okBar and tm_isPurple and tm_runDown and tm_nearSup and high > low and close > open
tm_sigBC = tm_i_evtOn and tm_okBar and tm_isPurple and tm_runUp and tm_nearRes and high > low and (high - close) >= 0.5 * (high - low)

var int   tm_svBar  = 0
var float tm_svPx   = na
var int   tm_bcBar  = 0
var float tm_bcPx   = na
var bool  tm_hasSV  = false
var bool  tm_hasBC  = false

if tm_sigSV
    tm_svBar := bar_index
    tm_svPx  := low
    tm_hasSV := true
if tm_sigBC
    tm_bcBar := bar_index
    tm_bcPx  := high
    tm_hasBC := true

tm_svFresh = tm_hasSV and bar_index - tm_svBar <= tm_i_lvFresh
tm_bcFresh = tm_hasBC and bar_index - tm_bcBar <= tm_i_lvFresh

// -----------------------------------------------------------------------------
//  A-P0-1 SWEEP TRUOC ST - afterfix rieng cua bo LongKaco VSA
//  Luat method (§4.1, §5 Setup A buoc 1 / Setup B buoc 2): truoc khi retest phai
//  co mot bar QUET - rau VUOT level roi DONG CUA quay lai trong vung (fakeout).
//  Ban cu khong kiem tra dieu nay; ban nay mac dinh BAT (tat duoc de A/B).
//    LONG : low < tm_svPx (quet day SV) va close > tm_svPx
//    SHORT: high > tm_bcPx (quet dinh BC) va close < tm_bcPx
//  Chi tinh bar quet SAU bar SV/BC (>= tm_svBar) va trong tm_i_sweepWin bar.
// -----------------------------------------------------------------------------
tm_sweepUpBar = tm_hasSV and not na(tm_svPx) and low < tm_svPx and close > tm_svPx
tm_sweepDnBar = tm_hasBC and not na(tm_bcPx) and high > tm_bcPx and close < tm_bcPx

var int tm_sweepUpBl = na
var int tm_sweepDnBl = na
if tm_sweepUpBar
    tm_sweepUpBl := bar_index
if tm_sweepDnBar
    tm_sweepDnBl := bar_index

// Tuoi cua lan quet gan nhat (-1 = chua co lan nao)
f_sweepAge(int b) =>
    na(b) ? -1 : bar_index - b

// Con trong cua so nhin lai hay khong (maxBars = 0 -> khong gioi han)
f_sweepRecent(int b, int maxBars) =>
    not na(b) and (maxBars <= 0 or bar_index - b <= maxBars)

tm_sweepL  = tm_hasSV and not na(tm_sweepUpBl) and tm_sweepUpBl >= tm_svBar and f_sweepRecent(tm_sweepUpBl, tm_i_sweepWin)
tm_sweepS  = tm_hasBC and not na(tm_sweepDnBl) and tm_sweepDnBl >= tm_bcBar and f_sweepRecent(tm_sweepDnBl, tm_i_sweepWin)
// Cong chi ap cho chien luoc 'VSA dao chieu': o che do Wyckoff, ban than Spring/UTAD
// DA la hanh vi "pha vo roi dong cua tro lai" -> ap them cong nua la thua.
tm_sweepGateOn = tm_i_sweepReq and not tm_wyckoffMode

// Secondary Test: retest moc SV/BC bang volume thap, gia vong trong vung ATR
// Kich hoat VAO LENH theo chien luoc (tm_wyckoffMode dinh nghia o 10_inputs)
//  - 'VSA dao chieu'   : SV/BC -> ST (retest volume thap) -> vao lenh
//  - 'VSA loc + Wyckoff': SV/BC chi la BO LOC vung; SU KIEN WYCKOFF moi la
//    THOI DIEM vao lenh. SHORT la gong doi xung cua LONG.
tm_evLong  = tm_i_wyckoffEvent == "Spring" ? tm_wSpring : tm_i_wyckoffEvent == "SOS" ? tm_wSos : tm_wLps
tm_evShort = tm_i_wyckoffEvent == "Spring" ? tm_wUtad : tm_i_wyckoffEvent == "SOS" ? tm_wSow : tm_wLpsy

// Tin hieu THO (chua qua cong sweep) - giu rieng de con bao duoc "bi loai vi thieu sweep"
tm_stRawL = tm_i_evtOn and tm_okBar and (tm_wyckoffMode ? (tm_evLong and tm_svFresh) : (tm_svFresh and tm_quietST and math.abs(low - tm_svPx) <= tm_i_retestT * tm_atr and close > open))
tm_stRawS = tm_i_evtOn and tm_okBar and (tm_wyckoffMode ? (tm_evShort and tm_bcFresh) : (tm_bcFresh and tm_quietST and math.abs(high - tm_bcPx) <= tm_i_retestT * tm_atr and close < open))

tm_sigSTl = tm_stRawL and (not tm_sweepGateOn or tm_sweepL)
tm_sigSTs = tm_stRawS and (not tm_sweepGateOn or tm_sweepS)
tm_sigST  = tm_sigSTl or tm_sigSTs

// Retest du moi dieu kien khac nhung bi cong sweep loai -> canh bao rieng
// (de nguoi dung thay minh dang mat bao nhieu setup vi luat moi nay)
tm_noSweep = tm_sweepGateOn and ((tm_stRawL and not tm_sweepL) or (tm_stRawS and not tm_sweepS))

// Level tu dong Entry/SL/TP - cap nhat khi ST xay ra (setup gan nhat, thay setup cu):
//   Entry = cuc tri SV/BC (level "limit tai do"); SL = cuc tri +/- buffer x ATR;
//   TP = pivot doi dien neu RR >= 1, nguoc lai fallback rrFb x R (xem docs 5/6/8).
//   Setup tu dong DONG khi gia cham TP/SL sau bar ST -> 60_viz xoa 3 duong,
//   chi con nhan ket qua tai bar cham (khong de duong cu keo dai het chart).
var float tm_lvlE       = na
var float tm_lvlS       = na
var float tm_lvlT       = na
var int   tm_lvlB       = 0
var int   tm_lvlDir     = 0
var bool  tm_lvlDone    = false
var string tm_lvlRes    = ""
var int   tm_lvlDoneBar = 0
// Entry la lenh LIMIT tai cuc tri SV/BC -> phai theo doi DA KHOP chua.
// Thieu buoc nay thi setup chua tung vao lenh van bi ghi "TP"/"SL" (xem
// docs/vsa-optimization.md muc 4.1).
var bool  tm_lvlFill    = false
var int   tm_lvlFillBar = 0
// Rui ro THAT cua setup (|entry - SL|) - dung de hien R va tinh fee_R cua setup.
var float tm_lvlRisk    = na

// Trang thai hien tren dashboard: huong bao cao uu tien ST vua xay ra (ke ca khi
// bi chan) de thay duoc "thieu sweep - dang cho" ngay tai bar do.
tm_sweepDirRep = tm_stRawL ? 1 : tm_stRawS ? -1 : tm_lvlDir
tm_sweepOK     = not tm_i_sweepReq ? true : tm_sweepDirRep == 1 ? tm_sweepL : tm_sweepDirRep == -1 ? tm_sweepS : tm_sweepL or tm_sweepS
tm_sweepBars   = tm_sweepDirRep == 1 ? f_sweepAge(tm_sweepUpBl) : f_sweepAge(tm_sweepDnBl)
tm_sweepDash   = not tm_i_sweepReq ? "Tat (kieu cu)" : tm_sweepOK ? "Dat (" + str.tostring(tm_sweepBars) + " bar truoc)" : "Thieu sweep - dang cho"

// -----------------------------------------------------------------------------
//  A-P1-1 TP MEASURED MOVE - che do TP thu 3 (method §5 buoc 6, §6 'TP = zone/
//  level doi dien ke tiep'): muc tieu = CHIEU DAI pha day truoc do chieu tiep tu
//  moc retest. Do dai lay tu pha day TRUOC (khong nhin tuong lai):
//    LONG : tm_mmUp = dinh khang cu gan nhat - day gan nhat (chieu cao pha giam)
//    SHORT: tm_mmDn = dinh gan nhat - day ho tro gan nhat (chieu cao pha tang)
//  Chi dung khi pha day di NGUOC chieu vi the (LONG can tm_highFresh, SHORT can
//  tm_lowFresh) va dai hon 1R; neu khong -> du phong rrFb x R (vd Setup C, ca 2
//  pivot cung huong).
// -----------------------------------------------------------------------------
tm_highRun1 = ta.highest(high, tm_i_run + 1)
tm_lowRun1  = ta.lowest(low, tm_i_run + 1)
tm_mmUp     = tm_lastPHigh - tm_lowRun1
tm_mmDn     = tm_highRun1 - tm_lastPLow
// SL LUON dat theo CAU TRUC (ngoai cuc tri SV/BC); chi ENTRY doi theo tm_entryMarket.
// risk = |entry - SL| la RUI RO THAT: dung cho ca TP theo R va cho fee_R cua setup.
// Bo qua setup neu risk <= 0 (entry da nam ngoai vung SL -> vo nghia).
if tm_sigSTl and tm_hasSV
    float e1  = (tm_entryMarket or tm_wyckoffMode) ? close : tm_svPx
    float sl1 = ((tm_wyckoffMode ? low : tm_svPx) - tm_i_slBuf * tm_atr)
    float rk1 = e1 - sl1
    // TP: 'Theo R' -> rrFb x R | 'Pivot' -> dinh doi dien neu RR >= 1 | 'MM' -> pha day
    float tpR1  = e1 + tm_i_rrFb * rk1
    float tpPv1 = not na(tm_lastPHigh) and tm_lastPHigh >= e1 + rk1 ? tm_lastPHigh : tpR1
    float tpM1  = tm_highFresh and not na(tm_mmUp) and tm_mmUp > rk1 ? e1 + tm_mmUp : tpR1
    if rk1 > 0
        tm_lvlE       := e1
        tm_lvlS       := sl1
        tm_lvlT       := tm_tpTheoR ? tpR1 : tm_tpMM ? tpM1 : tpPv1
        tm_lvlB       := bar_index
        tm_lvlDir     := 1
        tm_lvlDone    := false
        tm_lvlRes     := ""
        tm_lvlDoneBar := 0
        tm_lvlFill    := tm_entryMarket
        tm_lvlFillBar := tm_entryMarket ? bar_index : 0
        tm_lvlRisk    := rk1
if tm_sigSTs and tm_hasBC
    float e2  = (tm_entryMarket or tm_wyckoffMode) ? close : tm_bcPx
    float sl2 = ((tm_wyckoffMode ? high : tm_bcPx) + tm_i_slBuf * tm_atr)
    float rk2 = sl2 - e2
    // TP gong doi xung: 'Pivot' -> day doi dien neu RR >= 1 | 'MM' -> pha day xuong
    float tpR2  = e2 - tm_i_rrFb * rk2
    float tpPv2 = not na(tm_lastPLow) and tm_lastPLow <= e2 - rk2 ? tm_lastPLow : tpR2
    float tpM2  = tm_lowFresh and not na(tm_mmDn) and tm_mmDn > rk2 ? e2 - tm_mmDn : tpR2
    if rk2 > 0
        tm_lvlE       := e2
        tm_lvlS       := sl2
        tm_lvlT       := tm_tpTheoR ? tpR2 : tm_tpMM ? tpM2 : tpPv2
        tm_lvlB       := bar_index
        tm_lvlDir     := -1
        tm_lvlDone    := false
        tm_lvlRes     := ""
        tm_lvlDoneBar := 0
        tm_lvlFill    := tm_entryMarket
        tm_lvlFillBar := tm_entryMarket ? bar_index : 0
        tm_lvlRisk    := rk2

// Tu dong dong setup. THU TU QUAN TRONG:
//   1. Khop entry truoc (limit tai cuc tri SV/BC)
//   2. Chi xet TP/SL khi DA khop; uu tien SL - ke ca khi cung bar vua khop entry
//      roi xuyen luon SL (bao thu, dung khi gia quet qua vung do).
if not na(tm_lvlE) and not tm_lvlDone and bar_index > tm_lvlB
    if not tm_lvlFill
        if tm_lvlDir == 1 and low <= tm_lvlE
            tm_lvlFill    := true
            tm_lvlFillBar := bar_index
        else if tm_lvlDir == -1 and high >= tm_lvlE
            tm_lvlFill    := true
            tm_lvlFillBar := bar_index
    if tm_lvlFill
        if tm_lvlDir == 1
            if low <= tm_lvlS
                tm_lvlDone    := true
                tm_lvlRes     := "SL"
                tm_lvlDoneBar := bar_index
            else if high >= tm_lvlT
                tm_lvlDone    := true
                tm_lvlRes     := "TP"
                tm_lvlDoneBar := bar_index
        else if tm_lvlDir == -1
            if high >= tm_lvlS
                tm_lvlDone    := true
                tm_lvlRes     := "SL"
                tm_lvlDoneBar := bar_index
            else if low <= tm_lvlT
                tm_lvlDone    := true
                tm_lvlRes     := "TP"
                tm_lvlDoneBar := bar_index

// -----------------------------------------------------------------------------
//  A-P1-3 CLX-E - CLIMAX TAI TARGET (method §4.2 dong CLX-E, §7 buoc 8)
//  Setup dang mo (chua cham TP/SL) + volume TIM xuat hien khi gia DA di duoc
//  >= tm_i_clxR x R theo huong co loi  ->  phan luc ngich chieu tai vung loi
//  nhuan: xem xet CHOT / doi SL ve entry. Chi tinh mot lan cho moi setup.
// -----------------------------------------------------------------------------
var bool tm_clxE = false
if tm_sigST
    tm_clxE := false
if tm_isPurple and not tm_lvlDone and not na(tm_lvlE) and not na(tm_lvlRisk) and tm_lvlRisk > 0.0
    if tm_lvlDir == 1 and high >= tm_lvlE + tm_i_clxR * tm_lvlRisk
        tm_clxE := true
    else if tm_lvlDir == -1 and low <= tm_lvlE - tm_i_clxR * tm_lvlRisk
        tm_clxE := true

// Muc tien xa nhat setup da di duoc, tinh theo R - de biet con cach target bao xa
tm_clxMax = tm_lvlDir == 1 ? (high - tm_lvlE) / tm_lvlRisk : tm_lvlDir == -1 ? (tm_lvlE - low) / tm_lvlRisk : 0.0
tm_clxDash = not tm_i_clxOn ? "Tat" : tm_clxE ? "CO - xem xet CHOT" : na(tm_clxMax) ? "-" : str.tostring(tm_clxMax, "#.0") + "R / " + str.tostring(tm_i_clxR, "#.0") + "R"

// No Supply / No Demand: cot am tai H/T
tm_sigNS = tm_i_quietOn and tm_okBar and tm_quietLow and tm_nearSup and close > open
tm_sigND = tm_i_quietOn and tm_okBar and tm_quietLow and tm_nearRes and close < open

var string tm_lastEvt    = "-"
var int    tm_lastEvtBar = 0
if tm_sigSV or tm_sigBC or tm_sigST or tm_sigNS or tm_sigND
    tm_lastEvt    := tm_sigSV ? "SV" : tm_sigBC ? "BC" : tm_sigST ? "ST" : tm_sigNS ? "NS" : "ND"
    tm_lastEvtBar := bar_index
