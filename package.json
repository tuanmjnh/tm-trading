{
  "name": "tm-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trade desk tu dong: engine tin hieu + backtest (Node) + dashboard Nuxt UI + risk gate",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "ref": "node tools/pine-ref.mjs",
    "watch": "node tools/build.mjs --watch",
    "signal": "node tools/build.mjs indicator",
    "backtest": "node tools/build.mjs strategy",
    "vsa": "node tools/build.mjs vsa",
    "vsa:backtest": "node tools/build.mjs vsa-strategy",
    "copy": "npm run build && node tools/copy.mjs \"TM Signals BTC.pine\"",
    "copy:backtest": "npm run build && node tools/copy.mjs \"TM Backtest BTC.pine\"",
    "copy:vsa": "npm run build && node tools/copy.mjs \"TM VSA Wyckoff.pine\"",
    "copy:vsa:backtest": "npm run build && node tools/copy.mjs \"TM VSA Backtest.pine\"",
    "notify": "node server/webhook.mjs",
    "test": "node tools/smoke.mjs && node engine/test.mjs && node exec/test-risk.mjs && node exec/test-drift.mjs && node engine/test-db.mjs && node services/test.mjs",
    "test:pines": "node tools/smoke.mjs",
    "test:engine": "node engine/test.mjs",
    "test:risk": "node exec/test-risk.mjs",
    "test:drift": "node exec/test-drift.mjs",
    "test:db": "node engine/test-db.mjs",
    "test:services": "node services/test.mjs",
    "services": "node services/run.mjs watch",
    "services:once": "node services/run.mjs once",
    "services:status": "node services/run.mjs status",
    "engine:run": "node engine/run.mjs",
    "engine:league": "node engine/league.mjs",
    "test:app": "node tests/run-tests.mjs",
    "errors": "node tools/errors.mjs",
    "verify": "npm run build && npm test",
    "clean": "node -e \"import('node:fs').then(f=>{for(const p of ['pine/dist','logs'])f.rmSync(p,{recursive:true,force:true});console.log('da xoa pine/dist va logs/')})\"",
    "dev": "nuxt dev --port 4001",
    "app:build": "nuxt build",
    "app:preview": "nuxt preview --port 4001",
    "app:prepare": "nuxt prepare",
    "typecheck": "node tools/typecheck.mjs",
    "backup": "node tools/backup.mjs"
  },
  "dependencies": {
    "@he-tree/vue": "^2.10.5",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@simplewebauthn/types": "^12.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-emoji": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-youtube": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.0",
    "h3": "^1.15.11",
    "jose": "^5.9.6",
    "json-editor-vue": "^0.19.2",
    "mongoose": "^9.10.3",
    "nuxt": "^4.3.1",
    "pinia": "^4.0.3",
    "resend": "^6.30.0",
    "scule": "^1.3.0",
    "sortablejs": "^1.15.2",
    "tailwindcss": "4.3.3",
    "tm-hub-client": "1.0.3",
    "uuid": "^14.0.2",
    "vanilla-jsoneditor": "^3.13.0",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.0",
    "@types/node": "^22.10.2",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^10.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nitropack": "^2.11.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8"
  }
}
