{
  "name": "tm-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trade desk tu dong: engine tin hieu + backtest (Node) + dashboard Nuxt UI + risk gate",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nuxt build",
    "pine:build": "node tools/build.mjs",
    "pine:ref": "node tools/pine-ref.mjs",
    "pine:watch": "node tools/build.mjs --watch",
    "pine:signal": "node tools/build.mjs indicator",
    "pine:backtest": "node tools/build.mjs strategy",
    "pine:vsa": "node tools/build.mjs vsa",
    "pine:vsa:backtest": "node tools/build.mjs vsa-strategy",
    "pine:sweep": "node tools/build.mjs sweep",
    "pine:xau": "node tools/build.mjs xau",
    "pine:xau2": "node tools/build.mjs xau2",
    "pine:copy": "npm run pine:build && node tools/copy.mjs \"TM Signals.pine\"",
    "pine:copy:backtest": "npm run pine:build && node tools/copy.mjs \"TM Backtest.pine\"",
    "pine:copy:vsa": "npm run pine:build && node tools/copy.mjs \"TM VSA Wyckoff.pine\"",
    "pine:copy:vsa:backtest": "npm run pine:build && node tools/copy.mjs \"TM VSA Backtest.pine\"",
