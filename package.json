    "pine:copy:xau": "npm run pine:build && node tools/copy.mjs \"TM XAU Signals.pine\"",
    "pine:copy:xau2": "npm run pine:build && node tools/copy.mjs \"TM XAU Signals 2.pine\"",
    "notify": "node server/webhook.mjs",
    "test": "node tools/test-summary.mjs",
    "pine:test": "node tools/smoke.mjs",
    "test:engine": "node engine/test.mjs",
    "test:market": "node market/test.mjs",
    "test:journal": "node engine/test-journal.mjs",
    "test:preset-drift": "node engine/test-preset-drift.mjs",
    "test:stamp": "node exec/test-stamp.mjs",
    "test:ai-review": "node ai/test-review.mjs",
    "test:risk": "node exec/test-risk.mjs",
    "test:paper": "node exec/test-paper.mjs",
    "test:simulation": "node simulation/test.mjs",
    "test:drift": "node exec/test-drift.mjs",
    "test:mt5": "node exec/mt5/test.mjs",
    "test:db": "node engine/test-db.mjs",
    "test:services": "node services/test.mjs",
    "test:ai": "node ai/test.mjs",
    "ai:gateway": "node ai/gateway.mjs",
    "ai:agent": "node ai/agent.mjs",
    "ai:brief": "node ai/daily-brief.mjs --force",
    "ai:review": "node ai/review.mjs",
    "journal": "node engine/journal.mjs",
    "preset:drift": "node engine/preset-drift.mjs",
    "services": "node services/run.mjs watch",
    "services:once": "node services/run.mjs once",
    "services:status": "node services/run.mjs status",
    "engine:run": "node engine/run.mjs",
    "engine:league": "node engine/league.mjs",
    "test:app": "node tests/run-tests.mjs",
    "audit:tps": "node tools/audit-tps.mjs",
    "errors": "node tools/errors.mjs",
    "docs:check": "node tools/docs-check.mjs",
    "verify": "npm run pine:build && npm run docs:check && npm test",
    "clean": "node -e \"import('node:fs').then(f=>{for(const p of ['pine/dist','logs'])f.rmSync(p,{recursive:true,force:true});console.log('da xoa pine/dist va logs/')})\"",
    "dev": "nuxt dev --port 4001 --no-fork",
    "preview": "nuxt preview --port 4001",
    "postinstall": "nuxt prepare",
    "typecheck": "node tools/typecheck.mjs",
    "backup": "node tools/backup.mjs",
    "experiment:create": "node engine/experimentService.mjs create",
    "experiment:run": "node engine/experimentService.mjs run",
    "experiment:report": "node engine/experimentService.mjs report",
    "experiment:list": "node engine/experimentService.mjs list",
    "experiment:move": "node engine/experimentService.mjs move",
    "experiment:decide": "node engine/experimentService.mjs decide",
    "strategy:create": "node engine/strategyService.mjs create",
    "strategy:list": "node engine/strategyService.mjs list",
    "strategy:promote": "node engine/strategyService.mjs promote",
    "strategy:plan": "node engine/strategyService.mjs plan",
    "strategy:activate": "node engine/strategyService.mjs activate"
