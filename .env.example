# Copy thanh .env.example thanh .env roi dien gia tri. KHONG commit file .env.

PORT=8787

# Token bao ve webhook. TradingView KHONG gui duoc header tuy y (chi gui URL +
# JSON body) nen token phai nam TRONG URL:
#     http://<dia-chi-cua-ban>:8787/tm-alert/<TM_TOKEN>
# Bo trong hoac de sai -> /tm-alert tra 401 cho moi request (fail-closed).
# Doi token = doi URL trong alert cua TradingView.
TM_TOKEN=local-dev

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK=
