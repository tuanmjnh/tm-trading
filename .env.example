# Copy .env.example to .env and fill in values. DO NOT commit .env file.

PORT=8787

# Webhook protection token. TradingView cannot send custom headers (URL + JSON body only),
# so the token must be embedded in the URL:
#     http://<your-host>:8787/tm-alert/<TM_TOKEN>
# Empty or invalid -> /tm-alert returns 401 (fail-closed).
TM_TOKEN=local-dev

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK=

# --- Engine + market intelligence ---
MONGODB_URI=mongodb://localhost:27017/tm-trading

# --- Market plane (server/utils/market-plane.ts) ---
# Served symbols (comma-separated, must exist on the venue). More symbols =
# more WS streams + REST polls — widen deliberately, not by default.
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
# Empty MARKET_KLINE disables the fapi kline WS stream and builds candles
# from trades instead. PAPER_MARKET: fapi | spot (paper quotes/closes venue).
MARKET_KLINE=1m
PAPER_MARKET=fapi

# --- Cloned tm-hub modules (fail-soft if empty) ---
MONGODB_LOG_URI=mongodb://localhost:27017/tm-trading-logs
MONGODB_LOG_DB_NAME=tm-trading-logs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# --- Services (Phase 8) ---
# Funding extreme alert threshold (decimal: 0.0005 = 0.05% per 8h)
FUNDING_ALERT_RATE=0.0005
FUNDING_INTERVAL=900
# Scanner: min 24h quote volume (USDT) to be considered, deep-scan top N,
# Telegram alert when |24h change| >= SCANNER_ALERT_PCT (%)
SCANNER_MIN_QUOTE_VOL=30000000
SCANNER_TOP_N=40
SCANNER_ALERT_PCT=15
SCANNER_INTERVAL=900
# News: 12 official/commercial RSS feeds (no key needed: 3 crypto press + Fed +
# SEC EDGAR 8-K + ECB + 4 BLS releases + EIA + VnExpress). CryptoPanic only if token set.
NEWS_INTERVAL=600
# CRYPTOPANIC_TOKEN=
# §60.15 connector guards. NEWS_ALLOWED_HOSTS pins the fetch to a comma-separated
# host allowlist (empty = structural guards only: scheme, credentials, private
# IPs, redirects, size, content-type always apply). NEWS_USER_AGENT is the
# default UA; NEWS_SEC_UA overrides it for SEC EDGAR (fair-access requires a
# contact UA). NEWS_HTTP_TIMEOUT_MS bounds each request.
# NEWS_USER_AGENT=tm-trading-news/1.0 (contact: ops@example.com)
# NEWS_SEC_UA=tm-trading-news/1.0 (contact: ops@example.com)
# NEWS_ALLOWED_HOSTS=www.coindesk.com,cointelegraph.com,decrypt.co,federalreserve.gov,www.sec.gov,www.ecb.europa.eu,www.bls.gov,www.eia.gov,e.vnexpress.net
# FRED macro vintages (free key: https://fred.stlouisfed.org). Absent = macro service skips cleanly.
# FRED_API_KEY=
# MACRO_INTERVAL=21600
# LLM extraction of eligible headlines (budget-capped, runs daily). 0 = disabled.
# NEWS_EXTRACT_BUDGET=10
# NEWS_EXTRACT=0
# Heartbeat D9: overdue check cadence (watch) + Telegram re-reminder window
HEARTBEAT_CHECK_SEC=60
HEARTBEAT_REMIND_H=6

# --- Services (Phase 9) ---
# Regime (ASI/FNG/BTC.D/supply drift/alt sweep) cadence (seconds)
REGIME_INTERVAL=3600
# Alt sweep flag: circulating supply drift >= %/ngay (supply snapshot compare)
SUPPLY_DRIFT_FLAG_PCT=0.2
# Unlock calendar (TokenUnlocks is paid -> Phase 11): local JSON, optional.
# Missing file -> [] (fail-soft). Format: [{"symbol":"ARB","date":"2026-10-05T00:00:00Z","label":"Team"}]
# UNLOCKS_FILE=data/unlocks.json
# Liquidation zones cadence (seconds)
LIQ_INTERVAL=900
# Window to read real forceOrder events (hours) + Telegram alert cluster threshold (USD/hour)
LIQ_WINDOW_H=6
LIQ_ALERT_USD=5000000
# Price bin (%) to cluster real events + symbol list (majors)
LIQ_BIN_PCT=1
LIQ_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
# LIQ_EVENTS_FILE=data/liq-events.ndjson
# LIQ_WS_URL=wss://fstream.binance.com/ws/!forceOrder@arr

# --- Services (Phase 10) ---
# Confluence: daily combined score cadence (seconds; 86400 = once a day)
CONFLUENCE_INTERVAL=86400
# Top N symbols by |24h change| (from scanner mover snapshot)
CONFLUENCE_TOP=10
# Explicit symbol list (csv) — wins over mover-derived selection when set
# CONFLUENCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Kline TF + bar count (>= 60, warmup for sma50/lvFresh60) + recency window
# (each method scores the last CONFLUENCE_RECENCY bars)
CONFLUENCE_TF=60
CONFLUENCE_BARS=150
CONFLUENCE_RECENCY=12

# =============================================================================
#  tm-hub — tm-trading is a SATELLITE APP, NOT an auth provider.
#
#  tm-hub provides centralized authentication. Usage:
#    Step 1. Open tm-hub -> create app 'TM Trading' -> copy 'appId'
#    Step 2. Paste appId into NUXT_PUBLIC_HUB_APP_ID below.
#    Step 3. Start tm-hub (default port 4000), then 'npm run dev' for tm-trading.
#
#  Auth requests are routed directly to tm-hub with header 'X-App-Id':
#    POST ${NUXT_PUBLIC_HUB_URL}/api/v1/auth/login | register | refresh | logout
#    GET  ${NUXT_PUBLIC_HUB_URL}/api/v1/auth/me
#  SDK 'tm-hub-client' auto-injects X-App-Id + Bearer.
#
#  Env-key standard (v2, 2026-10-20): a satellite stores ONLY its own app id.
#  tm-hub's own id (HUB_APP_ID) and the sibling id (TOOLS_APP_ID) are NOT read
#  here — they live in the hub `apps` table and are managed by `pnpm seed` in
#  tm-hub. The legacy aliases HUB_APP_ID / TOOLS_APP_ID / NUXT_PUBLIC_HUB_API_URL
#  are no longer accepted; rename to NUXT_PUBLIC_HUB_APP_ID / NUXT_PUBLIC_HUB_URL.
# =============================================================================
NUXT_PUBLIC_HUB_URL=http://localhost:4000
NUXT_PUBLIC_HUB_APP_ID=tm-trading_your_app_id

# TM Hub AI relay (SERVER-ONLY): equal to this app's secret_key listed in the
# hub `apps` table. Enables POST /api/v1/ai/providers/hub/sync, which mirrors
# hub-granted AI connections as local provider='hub' rows. This app stores NO
# provider key — every hub-row call is proxied through the hub relay.
# NUXT_HUB_APP_SECRET=

# Offline JWT verification on tm-trading server (server/middleware/auth.ts).
# Value MUST match AUTH_JWT_SECRET in tm-hub/.env.
AUTH_JWT_SECRET=super-secure-shared-secret-key-32-chars-min
CONFIG_ENCRYPTION_KEY=
# Separate 32+ character key for AES-256-GCM encrypted exchange demo API credentials.
EXCHANGE_DEMO_CREDENTIAL_KEY=

# AI copilot (Phase 11: gateway + agent + daily brief)
# google_ai (Gemini) has a free tier and is the recommended default. Get a key at
# https://aistudio.google.com/apikey (starts with AIza). Other keys: openai
# (paid), openrouter (free tier), github_models (GitHub PAT), ollama (local).
AI_PROVIDER=google_ai         # google_ai | openai | anthropic | ollama | openrouter | github_models | freellmapi | opencode | custom_openai
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite   # fast free tier; use gemini-3.8-flash for higher quality (slower reasoning)
AI_CREDENTIAL_KEY=            # 32+ random chars; required to store provider secrets at rest (AES-256-GCM)
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=60000
AI_RPM=30                   # rate limit: calls per 60s (audited in logs/ai.ndjson)
AI_TEMPERATURE=0.3
AI_LANG=vi                  # brief / agent reply language
AI_LOG=1                    # 0 = stop appending logs/ai.ndjson
AI_BRIEF_INTERVAL=3600      # seconds between brief window checks (service)
AI_BRIEF_HOURS=6-10         # local hours when the brief may send (wrap: 22-4)
